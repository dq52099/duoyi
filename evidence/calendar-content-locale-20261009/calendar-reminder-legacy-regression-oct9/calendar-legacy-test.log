              'class _ProjectDetailSheet extends StatefulWidget {\n'
              '  final _CalendarOriginScope origin;\n'
              '  final _CalendarProjectOption option;\n'
              '  final List<TodoItem> todos;\n'
              '\n'
              '  const _ProjectDetailSheet({\n'
              '    required this.origin,\n'
              '    required this.option,\n'
              '    required this.todos,\n'
              '  });\n'
              '\n'
              '  @override\n'
              '  State<_ProjectDetailSheet> createState() => _ProjectDetailSheetState();\n'
              '}\n'
              '\n'
              'class _ProjectDetailSheetState extends State<_ProjectDetailSheet> {\n'
              '  ModalRoute<dynamic>? _owningRoute;\n'
              '\n'
              '  @override\n'
              '  void didChangeDependencies() {\n'
              '    super.didChangeDependencies();\n'
              '    _owningRoute ??= ModalRoute.of(context);\n'
              '  }\n'
              '\n'
              '  void _dismissOwningSheet() {\n'
              '    final route = _owningRoute ?? ModalRoute.of(context);\n'
              '    if (route != null && route.isActive) {\n'
              '      if (route.isCurrent) {\n'
              '        route.navigator?.pop();\n'
              '      } else {\n'
              '        route.navigator?.removeRoute(route);\n'
              '      }\n'
              '    }\n'
              '  }\n'
              '\n'
              '  void _openTodoScreen() {\n'
              '    if (!mounted || !widget.origin.isValid) {\n'
              '      _dismissOwningSheet();\n'
              '      return;\n'
              '    }\n'
              '    _dismissOwningSheet();\n'
              '    Navigator.push(\n'
              '      context,\n'
              '      MaterialPageRoute(\n'
              '        builder: (_) => const BrandRouteSurface(child: TodoScreen()),\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  void initState() {\n'
              '    super.initState();\n'
              '    I18n.localeListenable.addListener(_onLocaleChanged);\n'
              '  }\n'
              '\n'
              '  void _onLocaleChanged() {\n'
              '    if (mounted) setState(() {});\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  void dispose() {\n'
              '    I18n.localeListenable.removeListener(_onLocaleChanged);\n'
              '    super.dispose();\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final today = DateTime.now();\n'
              '    final todayKey = DateTime(today.year, today.month, today.day);\n'
              '    final completed = widget.todos.where((todo) => todo.isCompleted).length;\n'
              '    final overdue = widget.todos.where((todo) => todo.isOverdue).length;\n'
              '    final todayCount = widget.todos.where((todo) {\n'
              '      final d = DateTime(todo.date.year, todo.date.month, todo.date.day);\n'
              '      return d == todayKey;\n'
              '    }).length;\n'
              '\n'
              '    return AppModalSheet(\n'
              '      title: CalendarUiCopy.projectDetailSheetTitle,\n'
              '      subtitle: widget.option.displayName,\n'
              '      maxWidth: 860,\n'
              '      scrollable: false,\n'
              '      child: LayoutBuilder(\n'
              '        builder: (context, constraints) {\n'
              '          final sheetHeight = (MediaQuery.sizeOf(context).height * 0.68).clamp(\n'
              '            360.0,\n'
              '            680.0,\n'
              '          );\n'
              '          return SizedBox(\n'
              '            height: sheetHeight,\n'
              '            child: Column(\n'
              '              mainAxisSize: MainAxisSize.min,\n'
              '              children: [\n'
              '                LayoutBuilder(\n'
              '                  builder: (context, constraints) {\n'
              '                    final itemWidth = constraints.maxWidth >= 640\n'
              '                        ? (constraints.maxWidth - 36) / 4\n'
              '                        : (constraints.maxWidth - 12) / 2;\n'
              '                    return Wrap(\n'
              '                      spacing: 12,\n'
              '                      runSpacing: 12,\n'
              '                      children: [\n'
              '                        SizedBox(\n'
              '                          width: itemWidth,\n'
              '                          child: _ProjectStat(\n'
              '                            label: CalendarUiCopy.projectStatTotal,\n'
              '                            value: \'${widget.todos.length}\',\n'
              '                          ),\n'
              '                        ),\n'
              '                        SizedBox(\n'
              '                          width: itemWidth,\n'
              '                          child: _ProjectStat(\n'
              '                            label: CalendarUiCopy.projectStatCompleted,\n'
              '                            value: \'$completed\',\n'
              '                          ),\n'
              '                        ),\n'
              '                        SizedBox(\n'
              '                          width: itemWidth,\n'
              '                          child: _ProjectStat(\n'
              '                            label: CalendarUiCopy.projectStatOverdue,\n'
              '                            value: \'$overdue\',\n'
              '                          ),\n'
              '                        ),\n'
              '                        SizedBox(\n'
              '                          width: itemWidth,\n'
              '                          child: _ProjectStat(\n'
              '                            label: CalendarUiCopy.projectStatToday,\n'
              '                            value: \'$todayCount\',\n'
              '                          ),\n'
              '                        ),\n'
              '                      ],\n'
              '                    );\n'
              '                  },\n'
              '                ),\n'
              '                const SizedBox(height: 12),\n'
              '                Expanded(\n'
              '                  child: widget.todos.isEmpty\n'
              '                      ? Center(child: Text(CalendarUiCopy.projectEmptyTasks))\n'
              '                      : Scrollbar(\n'
              '                          child: ListView.separated(\n'
              '                            key: const ValueKey(\n'
              '                              \'calendar_project_detail_scroll_region\',\n'
              '                            ),\n'
              '                            primary: false,\n'
              '                            padding: EdgeInsets.zero,\n'
              '                            itemCount: widget.todos.length,\n'
              '                            separatorBuilder: (_, _) =>\n'
              '                                const Divider(height: 1),\n'
              '                            itemBuilder: (context, index) {\n'
              '                              final todo = widget.todos[index];\n'
              '                              final visual =\n'
              '                                  CompletionVisibilityPolicy.visualState(todo);\n'
              '                              final isCompleted =\n'
              '                                  visual == TodoVisualState.completed;\n'
              '                              final isOverdue =\n'
              '                                  visual == TodoVisualState.overdue;\n'
              '                              final statusColor = isCompleted\n'
              '                                  ? Theme.of(context).colorScheme.tertiary\n'
              '                                  : isOverdue\n'
              '                                  ? Theme.of(context).colorScheme.error\n'
              '                                  : null;\n'
              '                              return ListTile(\n'
              '                                dense: true,\n'
              '                                visualDensity: VisualDensity.compact,\n'
              '                                contentPadding: EdgeInsets.zero,\n'
              '                                leading: Icon(\n'
              '                                  isCompleted\n'
              '                                      ? Icons.check_circle\n'
              '                                      : isOverdue\n'
              '                                      ? Icons.priority_high_rounded\n'
              '                                      : Icons.radio_button_unchecked,\n'
              '                                  size: 18,\n'
              '                                  color: statusColor,\n'
              '                                ),\n'
              '                                title: Text(\n'
              '                                  todo.title,\n'
              '                                  maxLines: 1,\n'
              '                                  overflow: TextOverflow.ellipsis,\n'
              '                                  style: TextStyle(\n'
              '                                    color: isCompleted\n'
              '                                        ? Theme.of(\n'
              '                                            context,\n'
              '                                          ).colorScheme.onSurfaceVariant\n'
              '                                        : isOverdue\n'
              '                                        ? Theme.of(context).colorScheme.error\n'
              '                                        : null,\n'
              '                                    decoration: isCompleted\n'
              '                                        ? TextDecoration.lineThrough\n'
              '                                        : null,\n'
              '                                  ),\n'
              '                                ),\n'
              '                                subtitle: Wrap(\n'
              '                                  spacing: 6,\n'
              '                                  runSpacing: 4,\n'
              '                                  crossAxisAlignment: WrapCrossAlignment.center,\n'
              '                                  children: [\n'
              '                                    Text(\n'
              '                                      \'${todo.date.month}/${todo.date.day}${todo.priority != TodoPriority.none ? \' · ${todo.priority.label}\' : \'\'}\',\n'
              '                                      style: const TextStyle(fontSize: 11),\n'
              '                                    ),\n'
              '                                    if (statusColor != null)\n'
              '                                      Text(\n'
              '                                        isCompleted\n'
              '                                            ? MainUiCopy.calendarStatusCompleted\n'
              '                                            : MainUiCopy.calendarStatusOverdue,\n'
              '                                        style: TextStyle(\n'
              '                                          fontSize: 11,\n'
              '                                          color: statusColor,\n'
              '                                        ),\n'
              '                                      ),\n'
              '                                  ],\n'
              '                                ),\n'
              '                              );\n'
              '                            },\n'
              '                          ),\n'
              '                        ),\n'
              '                ),\n'
              '                const SizedBox(height: 10),\n'
              '                Align(\n'
              '                  alignment: Alignment.centerRight,\n'
              '                  child: FilledButton.tonalIcon(\n'
              '                    onPressed: _openTodoScreen,\n'
              '                    icon: const Icon(Icons.open_in_new),\n'
              '                    label: Text(CalendarUiCopy.openTodoScreenButton),\n'
              '                  ),\n'
              '                ),\n'
              '              ],\n'
              '            ),\n'
              '          );\n'
              '        },\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
