              '      _focusedMonth = DateTime(_selectedDay.year, _selectedDay.month);\n'
              '    });\n'
              '  }\n'
              '\n'
              '  void _nextThreeDays() {\n'
              '    setState(() {\n'
              '      _selectedDay = _selectedDay.add(const Duration(days: 3));\n'
              '      _focusedMonth = DateTime(_selectedDay.year, _selectedDay.month);\n'
              '    });\n'
              '  }\n'
              '\n'
              '  void _previousYear() {\n'
              '    setState(() {\n'
              '      _focusedMonth = DateTime(_focusedMonth.year - 1, _focusedMonth.month);\n'
              '      final targetYear = _selectedDay.year - 1;\n'
              '      final lastDay = DateTime(targetYear, _selectedDay.month + 1, 0).day;\n'
              '      final day = _selectedDay.day.clamp(1, lastDay);\n'
              '      _selectedDay = DateTime(targetYear, _selectedDay.month, day);\n'
              '    });\n'
              '  }\n'
              '\n'
              '  void _nextYear() {\n'
              '    setState(() {\n'
              '      _focusedMonth = DateTime(_focusedMonth.year + 1, _focusedMonth.month);\n'
              '      final targetYear = _selectedDay.year + 1;\n'
              '      final lastDay = DateTime(targetYear, _selectedDay.month + 1, 0).day;\n'
              '      final day = _selectedDay.day.clamp(1, lastDay);\n'
              '      _selectedDay = DateTime(targetYear, _selectedDay.month, day);\n'
              '    });\n'
              '  }\n'
              '\n'
              '  int _monthGridRows(DateTime focusedMonth) {\n'
              '    final firstDay = DateTime(focusedMonth.year, focusedMonth.month, 1);\n'
              '    final lastDay = DateTime(focusedMonth.year, focusedMonth.month + 1, 0);\n'
              '    final startOffset = (firstDay.weekday - 1) % 7;\n'
              '    return ((startOffset + lastDay.day) / 7).ceil();\n'
              '  }\n'
              '\n'
              '  double _monthGridHeightFor(double availableHeight, int rows) {\n'
              '    final minGridHeight = rows >= 6 ? 288.0 : (rows == 5 ? 260.0 : 236.0);\n'
              '    final preferredGridHeight = rows >= 6 ? 318.0 : (rows == 5 ? 292.0 : 268.0);\n'
              '    if (!availableHeight.isFinite) return preferredGridHeight;\n'
              '    final viewportTarget = availableHeight * 0.46;\n'
              '    return viewportTarget.clamp(minGridHeight, preferredGridHeight).toDouble();\n'
              '  }\n'
              '\n'
              '  Widget _calendarFilterChip({\n'
              '    Widget? avatar,\n'
              '    required Widget label,\n'
              '    required bool selected,\n'
              '    required ValueChanged<bool> onSelected,\n'
              '  }) {\n'
              '    final cs = Theme.of(context).colorScheme;\n'
              '    return Padding(\n'
              '      padding: const EdgeInsets.only(right: 6),\n'
              '      child: FilterChip(\n'
              '        avatar: avatar,\n'
              '        label: label,\n'
              '        selected: selected,\n'
              '        onSelected: onSelected,\n'
              '        showCheckmark: false,\n'
              '        labelStyle: appSecondaryControlLabelStyle(context),\n'
              '        visualDensity: VisualDensity.compact,\n'
              '        materialTapTargetSize: MaterialTapTargetSize.padded,\n'
              '        side: BorderSide(\n'
              '          color: selected\n'
              '              ? cs.primary.withValues(alpha: 0.24)\n'
              '              : cs.outlineVariant.withValues(alpha: 0.16),\n'
              '          width: 0.45,\n'
              '        ),\n'
              '        padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 1),\n'
              '        labelPadding: const EdgeInsets.symmetric(horizontal: 2),\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  Widget _calendarActionChip({\n'
              '    required Widget avatar,\n'
              '    required Widget label,\n'
              '    required VoidCallback onPressed,\n'
              '  }) {\n'
              '    final cs = Theme.of(context).colorScheme;\n'
              '    return Padding(\n'
              '      padding: const EdgeInsets.only(right: 6),\n'
              '      child: ActionChip(\n'
              '        avatar: avatar,\n'
              '        label: label,\n'
              '        labelStyle: appSecondaryControlLabelStyle(context),\n'
              '        visualDensity: VisualDensity.compact,\n'
              '        materialTapTargetSize: MaterialTapTargetSize.padded,\n'
              '        side: BorderSide(\n'
              '          color: cs.outlineVariant.withValues(alpha: 0.16),\n'
              '          width: 0.45,\n'
              '        ),\n'
              '        padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 1),\n'
              '        labelPadding: const EdgeInsets.symmetric(horizontal: 2),\n'
              '        onPressed: onPressed,\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  bool _monthGridShowsLunar(double gridHeight, int rows) {\n'
              '    if (rows <= 0) return false;\n'
              '    const monthGridChromeHeight = 36.0;\n'
              '    final rowHeight = (gridHeight - monthGridChromeHeight) / rows;\n'
              '    return rowHeight >= 50;\n'
              '  }\n'
              '\n'
              '  Widget _calendarFilterStrip({\n'
              '    required List<_CalendarWorkspaceOption> workspaceOptions,\n'
              '    required String? effectiveWorkspaceId,\n'
              '    required List<_CalendarProjectOption> projectOptions,\n'
              '    required String? effectiveProjectKey,\n'
              '    required List<TodoItem> workspaceTodos,\n'
              '  }) {\n'
              '    return SizedBox(\n'
              '      key: const ValueKey(\'calendar_unified_filter_strip\'),\n'
              '      height: 48,\n'
              '      child: DefaultTextStyle.merge(\n'
              '        style: appSecondaryControlLabelStyle(context),\n'
              '        child: ListView(\n'
              '          scrollDirection: Axis.horizontal,\n'
              '          padding: const EdgeInsets.symmetric(horizontal: 12),\n'
              '          children: [\n'
              '            _calendarFilterChip(\n'
              '              label: Text(CalendarUiCopy.filterAll),\n'
              '              selected: _activeTypes == null,\n'
              '              onSelected: (_) => setState(() => _activeTypes = null),\n'
              '            ),\n'
              '            if (projectOptions.isNotEmpty) ...[\n'
              '              const SizedBox(width: 6),\n'
              '              _calendarFilterChip(\n'
              '                avatar: const Icon(Icons.folder_outlined, size: 16),\n'
              '                label: Text(CalendarUiCopy.filterAllProjects),\n'
              '                selected: effectiveProjectKey == null,\n'
              '                onSelected: (_) => setState(() => _activeProjectKey = null),\n'
              '              ),\n'
              '              for (final option in projectOptions)\n'
              '                _calendarFilterChip(\n'
              '                  label: Text(\'${option.displayName} ${option.count}\'),\n'
              '                  selected: effectiveProjectKey == option.key,\n'
              '                  onSelected: (_) {\n'
              '                    setState(() {\n'
              '                      _activeProjectKey = option.key;\n'
              '                      if (_activeTypes != null &&\n'
              '                          !_activeTypes!.contains(CalendarEventType.todo)) {\n'
              '                        _activeTypes = {CalendarEventType.todo};\n'
              '                      }\n'
              '                    });\n'
              '                  },\n'
              '                ),\n'
              '              if (effectiveProjectKey != null)\n'
              '                _calendarActionChip(\n'
              '                  avatar: const Icon(Icons.info_outline, size: 16),\n'
              '                  label: Text(CalendarUiCopy.projectDetailAction),\n'
              '                  onPressed: () {\n'
              '                    final option = projectOptions.firstWhere(\n'
              '                      (item) => item.key == effectiveProjectKey,\n'
              '                    );\n'
              '                    _showProjectDetail(\n'
              '                      context,\n'
              '                      option,\n'
              '                      _projectTodos(workspaceTodos, option.key),\n'
              '                    );\n'
              '                  },\n'
              '                ),\n'
              '            ],\n'
              '            if (workspaceOptions.isNotEmpty) ...[\n'
              '              const SizedBox(width: 6),\n'
              '              _calendarFilterChip(\n'
              '                avatar: const Icon(Icons.groups_2_outlined, size: 16),\n'
              '                label: Text(CalendarUiCopy.filterAllWorkspaces),\n'
              '                selected: effectiveWorkspaceId == null,\n'
              '                onSelected: (_) => setState(() => _activeWorkspaceId = null),\n'
              '              ),\n'
              '              for (final option in workspaceOptions)\n'
              '                _calendarFilterChip(\n'
              '                  avatar: Icon(\n'
              '                    option.isPrivate\n'
              '                        ? Icons.lock_outline\n'
              '                        : Icons.groups_2_outlined,\n'
              '                    size: 16,\n'
              '                  ),\n'
              '                  label: Text(\'${option.displayName} ${option.count}\'),\n'
              '                  selected: effectiveWorkspaceId == option.id,\n'
              '                  onSelected: (_) {\n'
              '                    setState(() {\n'
              '                      _activeWorkspaceId = option.id;\n'
              '                    });\n'
              '                  },\n'
              '                ),\n'
              '            ],\n'
              '            for (final type in CalendarEventType.values)\n'
              '              _calendarFilterChip(\n'
              '                label: Text(type.label),\n'
              '                selected: _activeTypes?.contains(type) ?? false,\n'
              '                onSelected: (selected) {\n'
              '                  setState(() {\n'
              '                    if (_activeTypes == null) {\n'
              '                      _activeTypes = {type};\n'
              '                    } else if (selected) {\n'
              '                      _activeTypes = {..._activeTypes!, type};\n'
              '                    } else {\n'
              '                      final next = {..._activeTypes!}..remove(type);\n'
              '                      _activeTypes = next.isEmpty ? null : next;\n'
              '                    }\n'
              '                  });\n'
              '                },\n'
              '              ),\n'
              '          ],\n'
              '        ),\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  DateTime _clampSelectedDayToFocusedMonth() {\n'
              '    final lastDay = DateTime(\n'
              '      _focusedMonth.year,\n'
              '      _focusedMonth.month + 1,\n'
              '      0,\n'
              '    ).day;\n'
              '    final day = _selectedDay.day.clamp(1, lastDay);\n'
              '    return DateTime(_focusedMonth.year, _focusedMonth.month, day);\n'
              '  }\n'
              '\n'
              '  Future<void> _pickDate() async {\n'
              '    final origin = _createOriginScope();\n'
              '    final picked = await AppDatePicker.pickSolar(\n'
              '      context,\n'
              '      initialDate: _selectedDay,\n'
              '      firstDate: DateTime(1900),\n'
              '      lastDate: DateTime(2099, 12, 31),\n'
              '      titleKey: \'calendar.content.date_picker_title\',\n'
              '      subtitleKey: \'calendar.content.date_picker_subtitle\',\n'
              '    );\n'
              '    if (!origin.isValid) return;\n'
              '    if (picked == null) return;\n'
              '    setState(() {\n'
              '      _selectedDay = picked;\n'
              '      _focusedMonth = DateTime(picked.year, picked.month);\n'
              '    });\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final todoProvider = context.watch<TodoProvider>();\n'
              '    final habitProvider = context.watch<HabitProvider>();\n'
              '    context.select<PomodoroProvider, int>(\n'
              '      (provider) => provider.persistedRevision,\n'
              '    );\n'
              '    final pomodoroProvider = context.read<PomodoroProvider>();\n'
              '    final calendarProvider = context.watch<CalendarProvider>();\n'
              '    final anniversaryProvider = context.watch<AnniversaryProvider>();\n'
              '    final countdownProvider = context.watch<CountdownProvider>();\n'
              '    final courseProvider = context.watch<CourseProvider>();\n'
              '    final diaryProvider = context.watch<DiaryProvider>();\n'
              '    final goalProvider = context.watch<GoalProvider>();\n'
              '    final shareProvider = context.watch<ShareProvider>();\n'
              '    final timeAuditProvider = context.watch<TimeAuditProvider>();\n'
              '    final s = context.watch<ThemeProvider>().brand.strings;\n'
              '    final cs = Theme.of(context).colorScheme;\n'
              '\n'
              '    _scheduleCalendarRebuild(\n'
              '      todoProvider: todoProvider,\n'
              '      habitProvider: habitProvider,\n'
              '      pomodoroProvider: pomodoroProvider,\n'
              '      calendarProvider: calendarProvider,\n'
              '      anniversaryProvider: anniversaryProvider,\n'
              '      countdownProvider: countdownProvider,\n'
              '      courseProvider: courseProvider,\n'
              '      diaryProvider: diaryProvider,\n'
              '      goalProvider: goalProvider,\n'
              '      timeAuditProvider: timeAuditProvider,\n'
              '      colorScheme: cs,\n'
              '    );\n'
              '\n'
              '    final workspaceOptions = _workspaceOptions(\n'
              '      todoProvider.todos,\n'
              '      goalProvider.goals,\n'
              '      calendarProvider.localEvents,\n'
              '      shareProvider.workspaces,\n'
              '    );\n'
              '    final effectiveWorkspaceId =\n'
              '        workspaceOptions.any((option) => option.id == _activeWorkspaceId)\n'
              '        ? _activeWorkspaceId\n'
              '        : null;\n'
              '    final workspaceTodos = _workspaceTodos(\n'
              '      todoProvider.todos,\n'
              '      effectiveWorkspaceId,\n'
              '    );\n'
              '    final projectOptions = _projectOptions(workspaceTodos);\n'
              '    final effectiveProjectKey =\n'
              '        projectOptions.any((option) => option.key == _activeProjectKey)\n'
              '        ? _activeProjectKey\n'
              '        : null;\n'
              '    final hasActiveCalendarFilters =\n'
              '        _activeTypes != null ||\n'
              '        effectiveProjectKey != null ||\n'
              '        effectiveWorkspaceId != null;\n'
              '    final dateTypes = calendarProvider.filteredDateEventTypes(\n'
              '      _activeTypes,\n'
              '      projectKey: effectiveProjectKey,\n'
              '      workspaceId: effectiveWorkspaceId,\n'
              '    );\n'
              '    final dateCounts = calendarProvider.filteredDateEventCounts(\n'
              '      _activeTypes,\n'
              '      projectKey: effectiveProjectKey,\n'
              '      workspaceId: effectiveWorkspaceId,\n'
              '    );\n'
              '    final monthLabel = CalendarUiCopy.monthHeader(_focusedMonth);\n'
              '    final weekStart = _selectedDay.subtract(\n'
              '      Duration(days: _selectedDay.weekday - 1),\n'
              '    );\n'
              '    final weekEnd = weekStart.add(const Duration(days: 6));\n'
              '    final weekLabel =\n'
              '        \'${I18nDateFormat.monthDay(weekStart)} - ${I18nDateFormat.monthDay(weekEnd)}\';\n'
              '    final threeDayEnd = _selectedDay.add(const Duration(days: 2));\n'
              '    final threeDayLabel =\n'
              '        \'${I18nDateFormat.monthDay(_selectedDay)} - ${I18nDateFormat.monthDay(threeDayEnd)}\';\n'
              '    final yearLabel = CalendarUiCopy.yearHeader(_focusedMonth.year);\n'
              '    final routeBackground = Theme.of(context).brightness == Brightness.dark\n'
              '        ? Theme.of(context).colorScheme.surface\n'
              '        : Theme.of(context).colorScheme.surfaceContainerLowest;\n'
              '\n'
              '    return BrandScaffold(\n'
              '      paintBackground: !widget.useShellBackground,\n'
              '      appBar: AppBar(\n'
              '        title: Text(MainUiCopy.calendarTitle),\n'
              '        titleTextStyle: widget.useShellBackground\n'
              '            ? null\n'
              '            : appSecondaryRouteTitleTextStyle(context),\n'
              '        backgroundColor: widget.useShellBackground\n'
              '            ? Colors.transparent\n'
              '            : routeBackground.withValues(alpha: 0.96),\n'
              '        surfaceTintColor: Colors.transparent,\n'
              '        actions: [\n'
              '          IconButton(\n'
              '            tooltip: MainUiCopy.calendarBackToToday,\n'
              '            icon: const Icon(Icons.today_outlined),\n'
              '            onPressed: () {\n'
              '              final now = DateTime.now();\n'
              '              setState(() {\n'
              '                _selectedDay = now;\n'
              '                _focusedMonth = DateTime(now.year, now.month);\n'
              '              });\n'
              '            },\n'
              '          ),\n'
              '          PopupMenuButton<String>(\n'
              '            tooltip: MainUiCopy.calendarMenu,\n'
              '            icon: const Icon(Icons.more_horiz),\n'
              '            onSelected: (value) {\n'
              '              if (value == \'today\') {\n'
              '                final now = DateTime.now();\n'
              '                setState(() {\n'
              '                  _selectedDay = now;\n'
              '                  _focusedMonth = DateTime(now.year, now.month);\n'
              '                });\n'
              '              } else if (value == \'pick\') {\n'
              '                _pickDate();\n'
              '              } else if (value == \'month\') {\n'
              '                _tabController.animateTo(0);\n'
              '              } else if (value == \'week\') {\n'
              '                _tabController.animateTo(1);\n'
              '              } else if (value == \'day\') {\n'
              '                _tabController.animateTo(2);\n'
              '              } else if (value == \'three_day\') {\n'
              '                _tabController.animateTo(3);\n'
              '              } else if (value == \'year\') {\n'
              '                _tabController.animateTo(4);\n'
              '              }\n'
              '            },\n'
              '            itemBuilder: (context) => [\n'
              '              PopupMenuItem(\n'
              '                value: \'today\',\n'
              '                height: 38,\n'
              '                child: _LocaleAwareSecondaryMenuText(\n'
              '                  () => MainUiCopy.calendarBackToToday,\n'
              '                ),\n'
              '              ),\n'
              '              PopupMenuItem(\n'
              '                value: \'pick\',\n'
              '                height: 38,\n'
              '                child: _LocaleAwareSecondaryMenuText(\n'
              '                  () => MainUiCopy.calendarPickDate,\n'
              '                ),\n'
              '              ),\n'
              '              const PopupMenuDivider(),\n'
              '              PopupMenuItem(\n'
              '                value: \'month\',\n'
              '                height: 38,\n'
              '                child: _LocaleAwareSecondaryMenuText(\n'
              '                  () => MainUiCopy.calendarViewMonth,\n'
              '                ),\n'
              '              ),\n'
              '              PopupMenuItem(\n'
              '                value: \'week\',\n'
              '                height: 38,\n'
              '                child: _LocaleAwareSecondaryMenuText(\n'
              '                  () => MainUiCopy.calendarViewWeek,\n'
              '                ),\n'
              '              ),\n'
              '              PopupMenuItem(\n'
              '                value: \'day\',\n'
              '                height: 38,\n'
              '                child: _LocaleAwareSecondaryMenuText(\n'
              '                  () => MainUiCopy.calendarViewDay,\n'
              '                ),\n'
              '              ),\n'
              '              PopupMenuItem(\n'
              '                value: \'three_day\',\n'
              '                height: 38,\n'
              '                child: _LocaleAwareSecondaryMenuText(\n'
              '                  () => MainUiCopy.calendarViewThreeDay,\n'
              '                ),\n'
              '              ),\n'
              '              PopupMenuItem(\n'
              '                value: \'year\',\n'
              '                height: 38,\n'
              '                child: _LocaleAwareSecondaryMenuText(\n'
              '                  () => MainUiCopy.calendarViewYear,\n'
              '                ),\n'
              '              ),\n'
              '            ],\n'
              '          ),\n'
              '        ],\n'
              '      ),\n'
              '      body: Column(\n'
              '        children: [\n'
              '          _CalendarNavigationHeader(\n'
              '            tabIndex: _tabController.index,\n'
              '            monthLabel: monthLabel,\n'
              '            weekLabel: weekLabel,\n'
              '            dayLabel: I18nDateFormat.date(_selectedDay),\n'
              '            threeDayLabel: threeDayLabel,\n'
              '            yearLabel: yearLabel,\n'
              '            onPreviousMonth: _previousMonth,\n'
              '            onNextMonth: _nextMonth,\n'
              '            onPreviousWeek: _previousWeek,\n'
              '            onNextWeek: _nextWeek,\n'
              '            onPreviousDay: _previousDay,\n'
              '            onNextDay: _nextDay,\n'
              '            onPreviousThreeDays: _previousThreeDays,\n'
              '            onNextThreeDays: _nextThreeDays,\n'
              '            onPreviousYear: _previousYear,\n'
              '            onNextYear: _nextYear,\n'
              '            onPickDate: _pickDate,\n'
              '          ),\n'
              '          Material(\n'
              '            color: cs.surface,\n'
              '            child: TabBar(\n'
              '              controller: _tabController,\n'
              '              isScrollable: true,\n'
              '              tabAlignment: TabAlignment.start,\n'
              '              padding: const EdgeInsets.fromLTRB(12, 0, 12, 4),\n'
              '              labelPadding: const EdgeInsets.symmetric(horizontal: 14),\n'
              '              tabs: [\n'
              '                Tab(height: 34, text: s.calendarTabMonth),\n'
              '                Tab(height: 34, text: s.calendarTabWeek),\n'
              '                Tab(height: 34, text: s.calendarTabDay),\n'
              '                Tab(height: 34, text: CalendarUiCopy.tabThreeDay),\n'
              '                Tab(height: 34, text: CalendarUiCopy.tabYear),\n'
              '              ],\n'
              '              labelStyle: appSecondaryMenuItemTextStyle(context),\n'
              '              unselectedLabelStyle: appSecondaryMenuItemTextStyle(context),\n'
              '              indicatorSize: TabBarIndicatorSize.tab,\n'
              '              dividerColor: Colors.transparent,\n'
              '              indicator: BoxDecoration(\n'
              '                color: Color.alphaBlend(\n'
              '                  cs.primary.withValues(alpha: 0.10),\n'
              '                  cs.surface,\n'
              '                ),\n'
              '                borderRadius: BorderRadius.circular(12),\n'
              '                border: Border.all(\n'
              '                  color: cs.primary.withValues(alpha: 0.20),\n'
              '                  width: 0.45,\n'
              '                ),\n'
              '              ),\n'
              '              labelColor: cs.onSurface,\n'
              '              unselectedLabelColor: cs.onSurfaceVariant,\n'
              '            ),\n'
              '          ),\n'
              '          _calendarFilterStrip(\n'
              '            workspaceOptions: workspaceOptions,\n'
              '            effectiveWorkspaceId: effectiveWorkspaceId,\n'
              '            projectOptions: projectOptions,\n'
              '            effectiveProjectKey: effectiveProjectKey,\n'
              '            workspaceTodos: workspaceTodos,\n'
              '          ),\n'
              '          Expanded(\n'
              '            child: TabBarView(\n'
              '              controller: _tabController,\n'
              '              children: [\n'
              '                // Month\n'
              '                LayoutBuilder(\n'
              '                  builder: (context, constraints) {\n'
              '                    final monthRows = _monthGridRows(_focusedMonth);\n'
              '                    final monthGridHeight = _monthGridHeightFor(\n'
              '                      constraints.maxHeight,\n'
              '                      monthRows,\n'
              '                    );\n'
              '                    final showLunar = _monthGridShowsLunar(\n'
              '                      monthGridHeight,\n'
              '                      monthRows,\n'
              '                    );\n'
              '                    return Scrollbar(\n'
              '                      key: const ValueKey(\'calendar_month_global_scrollbar\'),\n'
              '                      child: ListView(\n'
              '                        key: const ValueKey(\n'
              '                          \'calendar_month_global_scroll_view\',\n'
              '                        ),\n'
              '                        primary: false,\n'
              '                        padding: const EdgeInsets.fromLTRB(8, 8, 8, 12),\n'
              '                        children: [\n'
              '                          AppSurfaceCard(\n'
              '                            key: const ValueKey(\n'
              '                              \'calendar_month_grid_skin_card\',\n'
              '                            ),\n'
              '                            padding: EdgeInsets.zero,\n'
              '                            borderRadius: BorderRadius.circular(12),\n'
              '                            child: SizedBox(\n'
              '                              key: const ValueKey(\'calendar_fixed_month_grid\'),\n'
              '                              height: monthGridHeight,\n'
              '                              child: CalendarMonthGrid(\n'
              '                                focusedMonth: _focusedMonth,\n'
              '                                selectedDay: _selectedDay,\n'
              '                                dateEventTypes: dateTypes,\n'
              '                                dateEventCounts: dateCounts,\n'
              '                                showLunar: showLunar,\n'
              '                                onDaySelected: (d) => setState(() {\n'
              '                                  _selectedDay = d;\n'
              '                                  _focusedMonth = DateTime(d.year, d.month);\n'
              '                                }),\n'
              '                              ),\n'
              '                            ),\n'
              '                          ),\n'
              '                          Divider(\n'
              '                            height: 8,\n'
              '                            thickness: 0.5,\n'
              '                            color: Theme.of(context).colorScheme.outlineVariant\n'
              '                                .withValues(alpha: 0.18),\n'
              '                          ),\n'
              '                          AppSurfaceCard(\n'
              '                            key: const ValueKey(\'calendar_month_detail_agenda\'),\n'
              '                            padding: EdgeInsets.zero,\n'
              '                            borderRadius: BorderRadius.circular(12),\n'
              '                            child: CalendarDayAgenda(\n'
              '                              date: _selectedDay,\n'
              '                              calendarProvider: calendarProvider,\n'
              '                              activeTypes: _activeTypes,\n'
              '                              projectKey: effectiveProjectKey,\n'
              '                              workspaceId: effectiveWorkspaceId,\n'
              '                              hasActiveFilters: hasActiveCalendarFilters,\n'
              '                              horizontalPadding: 8,\n'
              '                              scrollable: false,\n'
              '                              previewLimit: 8,\n'
              '                            ),\n'
              '                          ),\n'
              '                        ],\n'
              '                      ),\n'
              '                    );\n'
              '                  },\n'
              '                ),\n'
              '                // Week\n'
              '                CalendarWeekStrip(\n'
              '                  selectedDay: _selectedDay,\n'
              '                  dateEventTypes: dateTypes,\n'
              '                  calendarProvider: calendarProvider,\n'
              '                  onDaySelected: (d) => setState(() {\n'
              '                    _selectedDay = d;\n'
              '                    _focusedMonth = DateTime(d.year, d.month);\n'
              '                  }),\n'
              '                  activeTypes: _activeTypes,\n'
              '                  projectKey: effectiveProjectKey,\n'
              '                  workspaceId: effectiveWorkspaceId,\n'
              '                  hasActiveFilters: hasActiveCalendarFilters,\n'
              '                ),\n'
              '                // Day\n'
              '                Padding(\n'
              '                  padding: const EdgeInsets.fromLTRB(8, 8, 8, 12),\n'
              '                  child: AppSurfaceCard(\n'
              '                    key: const ValueKey(\'calendar_day_agenda_skin_card\'),\n'
              '                    padding: EdgeInsets.zero,\n'
              '                    borderRadius: BorderRadius.circular(12),\n'
              '                    child: CalendarDayAgenda(\n'
              '                      date: _selectedDay,\n'
              '                      calendarProvider: calendarProvider,\n'
              '                      activeTypes: _activeTypes,\n'
              '                      projectKey: effectiveProjectKey,\n'
              '                      workspaceId: effectiveWorkspaceId,\n'
              '                      hasActiveFilters: hasActiveCalendarFilters,\n'
              '                      horizontalPadding: 8,\n'
              '                    ),\n'
              '                  ),\n'
              '                ),\n'
              '                // Three-day\n'
              '                _CalendarThreeDayView(\n'
              '                  key: const ValueKey(\'calendar_three_day_view\'),\n'
              '                  hasActiveFilters: hasActiveCalendarFilters,\n'
              '                  startDate: _selectedDay,\n'
              '                  calendarProvider: calendarProvider,\n'
              '                  activeTypes: _activeTypes,\n'
              '                  projectKey: effectiveProjectKey,\n'
              '                  workspaceId: effectiveWorkspaceId,\n'
              '                ),\n'
              '                // Year\n'
              '                _CalendarYearOverview(\n'
              '                  key: const ValueKey(\'calendar_year_overview\'),\n'
              '                  year: _focusedMonth.year,\n'
              '                  selectedDay: _selectedDay,\n'
              '                  dateEventTypes: dateTypes,\n'
              '                  onMonthTap: (month) {\n'
              '                    setState(() {\n'
              '                      _focusedMonth = DateTime(_focusedMonth.year, month);\n'
              '                      _selectedDay = DateTime(_focusedMonth.year, month, 1);\n'
              '                      _tabController.animateTo(0);\n'
              '                    });\n'
              '                  },\n'
              '                ),\n'
              '              ],\n'
              '            ),\n'
              '          ),\n'
              '        ],\n'
              '      ),\n'
              '      floatingActionButton: FloatingActionButton(\n'
              '        tooltip: CalendarUiCopy.quickAddTooltip,\n'
              '        onPressed: () => _showQuickAddMenu(context),\n'
              '        child: const Icon(Icons.add),\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  List<_CalendarProjectOption> _projectOptions(List<TodoItem> todos) {\n'
              '    final options = <_CalendarProjectOption>[];\n'
              '    for (final todo in todos) {\n'
              '      final trimmedName = todo.listGroupName?.trim();\n'
              '      final hasGroupName = trimmedName != null && trimmedName.isNotEmpty;\n'
              '      final key = todo.listGroupId?.isNotEmpty == true\n'
              '          ? todo.listGroupId!\n'
              '          : (hasGroupName ? trimmedName : \'\');\n'
              '      final name = hasGroupName ? trimmedName : \'\';\n'
              '      final index = options.indexWhere((option) => option.key == key);\n'
              '      if (index == -1) {\n'
              '        options.add(_CalendarProjectOption(key: key, name: name, count: 1));\n'
              '      } else {\n'
              '        final current = options[index];\n'
              '        options[index] = _CalendarProjectOption(\n'
              '          key: current.key,\n'
              '          name: current.name.isNotEmpty ? current.name : name,\n'
              '          count: current.count + 1,\n'
              '        );\n'
              '      }\n'
              '    }\n'
              '    options.sort((a, b) {\n'
              '      if (a.key.isEmpty) return 1;\n'
              '      if (b.key.isEmpty) return -1;\n'
              '      return a.displayName.compareTo(b.displayName);\n'
              '    });\n'
              '    return options;\n'
              '  }\n'
              '\n'
              '  List<_CalendarWorkspaceOption> _workspaceOptions(\n'
              '    List<TodoItem> todos,\n'
              '    List<GoalItem> goals,\n'
              '    List<CalendarEvent> localEvents,\n'
              '    List<Workspace> workspaces,\n'
              '  ) {\n'
              '    final counts = <String, int>{};\n'
              '    void addCount(String? rawWorkspaceId) {\n'
              '      final workspaceId =\n'
              '          rawWorkspaceId == null || rawWorkspaceId.trim().isEmpty\n'
              '          ? \'private\'\n'
              '          : rawWorkspaceId.trim();\n'
              '      counts[workspaceId] = (counts[workspaceId] ?? 0) + 1;\n'
              '    }\n'
              '\n'
              '    for (final todo in todos) {\n'
              '      addCount(todo.workspaceId);\n'
              '    }\n'
              '    for (final goal in goals) {\n'
              '      addCount(goal.workspaceId);\n'
              '    }\n'
              '    for (final event in localEvents) {\n'
              '      addCount(event.workspaceId);\n'
              '    }\n'
              '    final options = <_CalendarWorkspaceOption>[];\n'
              '    final privateCount = counts.remove(\'private\');\n'
              '    final knownWorkspaceIds = <String>{};\n'
              '    for (final workspace in workspaces) {\n'
              '      if (workspace.isPrivate) continue;\n'
              '      knownWorkspaceIds.add(workspace.id);\n'
              '    }\n'
              '    for (final workspace in workspaces) {\n'
              '      if (workspace.isPrivate) continue;\n'
              '      options.add(\n'
              '        _CalendarWorkspaceOption(\n'
              '          id: workspace.id,\n'
              '          name: workspace.name,\n'
              '          count: counts[workspace.id] ?? 0,\n'
              '          isPrivate: false,\n'
              '        ),\n'
              '      );\n'
              '    }\n'
              '    for (final entry in counts.entries) {\n'
              '      if (knownWorkspaceIds.contains(entry.key)) continue;\n'
              '      Workspace? workspace;\n'
              '      for (final item in workspaces) {\n'
              '        if (item.id == entry.key) {\n'
              '          workspace = item;\n'
              '          break;\n'
              '        }\n'
              '      }\n'
              '      options.add(\n'
              '        _CalendarWorkspaceOption(\n'
              '          id: entry.key,\n'
              '          name: workspace?.name ?? \'\',\n'
              '          count: entry.value,\n'
              '          isPrivate: false,\n'
              '          isFallbackShared: workspace == null || workspace.name.isEmpty,\n'
              '        ),\n'
              '      );\n'
              '    }\n'
              '    if (privateCount != null && privateCount > 0) {\n'
              '      options.add(\n'
              '        _CalendarWorkspaceOption(\n'
              '          id: \'private\',\n'
              '          name: \'\',\n'
              '          count: privateCount,\n'
              '          isPrivate: true,\n'
              '        ),\n'
              '      );\n'
              '    }\n'
              '    if (!options.any((option) => !option.isPrivate)) {\n'
              '      return const <_CalendarWorkspaceOption>[];\n'
              '    }\n'
              '    options.sort((a, b) {\n'
              '      if (a.isPrivate && !b.isPrivate) return 1;\n'
              '      if (!a.isPrivate && b.isPrivate) return -1;\n'
              '      return a.displayName.compareTo(b.displayName);\n'
              '    });\n'
              '    return options;\n'
              '  }\n'
              '\n'
              '  List<TodoItem> _projectTodos(List<TodoItem> todos, String projectKey) {\n'
              '    return todos.where((todo) {\n'
              '      final trimmedName = todo.listGroupName?.trim();\n'
              '      final key = todo.listGroupId?.isNotEmpty == true\n'
              '          ? todo.listGroupId!\n'
              '          : (trimmedName == null || trimmedName.isEmpty ? \'\' : trimmedName);\n'
              '      return key == projectKey;\n'
              '    }).toList();\n'
              '  }\n'
              '\n'
              '  List<TodoItem> _workspaceTodos(List<TodoItem> todos, String? workspaceId) {\n'
              '    if (workspaceId == null) return todos;\n'
              '    return todos.where((todo) {\n'
              '      final todoWorkspaceId = todo.workspaceId.trim().isEmpty\n'
              '          ? \'private\'\n'
              '          : todo.workspaceId.trim();\n'
              '      return todoWorkspaceId == workspaceId;\n'
              '    }).toList();\n'
              '  }\n'
              '\n'
              '  _CalendarOriginScope _createOriginScope() {\n'
              '    return _CalendarOriginScope(\n'
              '      accountGeneration: AccountLocalDataCleaner.accountDataGeneration,\n'
              '      selectedDay: _selectedDay,\n'
              '      activeWorkspaceId: _activeWorkspaceId,\n'
              '      isCallerActive: () => mounted && !_callerLifecycleNotifier._isDisposed,\n'
              '      callerAvailabilityListenable: _callerLifecycleNotifier,\n'
              '    );\n'
              '  }\n'
              '\n'
              '  Future<void> _showProjectDetail(\n'
              '    BuildContext context,\n'
              '    _CalendarProjectOption option,\n'
              '    List<TodoItem> todos,\n'
              '  ) {\n'
              '    final origin = _createOriginScope();\n'
              '    return showAppModalSheet<void>(\n'
              '      context: context,\n'
              '      builder: (_) =>\n'
              '          _ProjectDetailSheet(origin: origin, option: option, todos: todos),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  void _showQuickAddMenu(BuildContext context) {\n'
              '    final routeContext = context;\n'
              '    final origin = _createOriginScope();\n'
              '    showAppModalSheet<void>(\n'
              '      context: context,\n'
              '      builder: (_) => _QuickAddMenuSheet(\n'
              '        origin: origin,\n'
              '        onAiSchedule: () {\n'
              '          if (!origin.isValid) return;\n'
              '          Navigator.push(\n'
              '            routeContext,\n'
              '            MaterialPageRoute(\n'
              '              builder: (_) => BrandRouteSurface(\n'
              '                child: AiScheduleScreen(initialDate: origin.selectedDay),\n'
              '              ),\n'
              '            ),\n'
              '          );\n'
              '        },\n'
              '        onNewEvent: () {\n'
              '          if (!origin.isValid) return;\n'
              '          showLocalCalendarEventEditor(\n'
              '            routeContext,\n'
              '            initialDate: origin.selectedDay,\n'
              '            workspaceId: origin.activeWorkspaceId,\n'
              '          );\n'
              '        },\n'
              '        onNewTodo: () {\n'
              '          if (!origin.isValid) return;\n'
              '          _showQuickAddTodo(origin: origin);\n'
              '        },\n'
              '        onQuickAddTimeEntry: () {\n'
              '          if (!origin.isValid) return;\n'
              '          _showQuickAddTimeEntry(origin: origin);\n'
              '        },\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  Future<void> _showQuickAddTimeEntry({_CalendarOriginScope? origin}) async {\n'
              '    final effectiveOrigin = origin ?? _createOriginScope();\n'
              '    if (!effectiveOrigin.isValid) return;\n'
              '    await showDialog<void>(\n'
              '      context: context,\n'
              '      builder: (_) => _QuickAddTimeEntryDialog(origin: effectiveOrigin),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _CallerLifecycleNotifier implements Listenable {\n'
              '  final List<VoidCallback> _listeners = [];\n'
              '  bool _isDisposed = false;\n'
              '\n'
              '  void notifyCallerDisposed() {\n'
              '    if (_isDisposed) return;\n'
              '    _isDisposed = true;\n'
              '    final copy = List<VoidCallback>.from(_listeners);\n'
              '    for (final listener in copy) {\n'
              '      listener();\n'
              '    }\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  void addListener(VoidCallback listener) {\n'
              '    if (_isDisposed) {\n'
              '      listener();\n'
              '      return;\n'
              '    }\n'
              '    _listeners.add(listener);\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  void removeListener(VoidCallback listener) {\n'
              '    _listeners.remove(listener);\n'
              '  }\n'
              '}\n'
              '\n'
              'class _CalendarOriginScope {\n'
              '  final int accountGeneration;\n'
              '  final DateTime selectedDay;\n'
              '  final String? activeWorkspaceId;\n'
              '  final bool Function() isCallerActive;\n'
              '  final Listenable? callerAvailabilityListenable;\n'
              '\n'
              '  const _CalendarOriginScope({\n'
              '    required this.accountGeneration,\n'
              '    required this.selectedDay,\n'
              '    required this.activeWorkspaceId,\n'
              '    required this.isCallerActive,\n'
              '    this.callerAvailabilityListenable,\n'
              '  });\n'
              '\n'
              '  bool get isValid =>\n'
              '      isCallerActive() &&\n'
              '      AccountLocalDataCleaner.isCurrentAccountDataGeneration(accountGeneration);\n'
              '}\n'
              '\n'
              'class _CalendarFeedbackErrorText extends StatelessWidget {\n'
              '  const _CalendarFeedbackErrorText();\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    return ValueListenableBuilder<AppLocale>(\n'
              '      valueListenable: I18n.localeListenable,\n'
              '      builder: (context, _, _) => Text(CalendarUiCopy.saveFailed),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _LocaleAwareText extends StatelessWidget {\n'
              '  final String Function() textBuilder;\n'
              '\n'
              '  const _LocaleAwareText(this.textBuilder);\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    return ValueListenableBuilder<AppLocale>(\n'
              '      valueListenable: I18n.localeListenable,\n'
              '      builder: (context, _, _) => Text(textBuilder()),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _LocaleAwareSecondaryMenuText extends StatelessWidget {\n'
              '  final String Function() textBuilder;\n'
              '\n'
              '  const _LocaleAwareSecondaryMenuText(this.textBuilder);\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    return ValueListenableBuilder<AppLocale>(\n'
              '      valueListenable: I18n.localeListenable,\n'
              '      builder: (context, _, _) => AppSecondaryMenuText(textBuilder()),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _CalendarProjectOption {\n'
              '  final String key;\n'
              '  final String name;\n'
              '  final int count;\n'
              '\n'
              '  const _CalendarProjectOption({\n'
              '    required this.key,\n'
              '    required this.name,\n'
              '    required this.count,\n'
              '  });\n'
              '\n'
              '  String get displayName =>\n'
              '      key.isEmpty || name.isEmpty ? CalendarUiCopy.ungroupedProject : name;\n'
              '}\n'
              '\n'
              'class _CalendarWorkspaceOption {\n'
              '  final String id;\n'
              '  final String name;\n'
              '  final int count;\n'
              '  final bool isPrivate;\n'
              '  final bool isFallbackShared;\n'
              '\n'
              '  const _CalendarWorkspaceOption({\n'
              '    required this.id,\n'
              '    required this.name,\n'
              '    required this.count,\n'
              '    required this.isPrivate,\n'
              '    this.isFallbackShared = false,\n'
              '  });\n'
              '\n'
              '  String get displayName {\n'
              '    if (isPrivate) return CalendarUiCopy.personalWorkspace;\n'
              '    if (isFallbackShared || name.isEmpty) return CalendarUiCopy.sharedWorkspace;\n'
              '    return name;\n'
              '  }\n'
              '}\n'
              '\n'
              'class _QuickAddTodoDialog extends StatefulWidget {\n'
              '  final _CalendarOriginScope origin;\n'
              '\n'
              '  const _QuickAddTodoDialog({required this.origin});\n'
              '\n'
              '  @override\n'
              '  State<_QuickAddTodoDialog> createState() => _QuickAddTodoDialogState();\n'
              '}\n'
              '\n'
              'class _QuickAddTodoDialogState extends State<_QuickAddTodoDialog> {\n'
              '  late final TextEditingController _titleController;\n'
              '  late final FocusNode _focusNode;\n'
              '  bool _submitting = false;\n'
              '  bool _saved = false;\n'
              '  ModalRoute<dynamic>? _owningRoute;\n'
              '\n'
              '  @override\n'
              '  void didChangeDependencies() {\n'
              '    super.didChangeDependencies();\n'
              '    _owningRoute ??= ModalRoute.of(context);\n'
              '  }\n'
              '\n'
              '  void _dismissOwningDialog() {\n'
              '    final route = _owningRoute ?? ModalRoute.of(context);\n'
              '    if (route != null && route.isActive) {\n'
              '      if (route.isCurrent) {\n'
              '        route.navigator?.pop();\n'
              '      } else {\n'
              '        route.navigator?.removeRoute(route);\n'
              '      }\n'
              '    }\n'
              '  }\n'
              '\n'
              '  void _showFeedbackError(BuildContext context) {\n'
              '    if (!context.mounted) return;\n'
              '    final messenger = ScaffoldMessenger.maybeOf(context);\n'
              '    if (messenger == null || !messenger.mounted) return;\n'
              '    messenger.showSnackBar(\n'
              '      const SnackBar(content: _CalendarFeedbackErrorText()),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  void initState() {\n'
              '    super.initState();\n'
              '    _titleController = TextEditingController();\n'
              '    _focusNode = FocusNode();\n'
              '    I18n.localeListenable.addListener(_onLocaleChanged);\n'
              '  }\n'
              '\n'
              '  void _onLocaleChanged() {\n'
              '    if (mounted) setState(() {});\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  void dispose() {\n'
              '    I18n.localeListenable.removeListener(_onLocaleChanged);\n'
              '    _titleController.dispose();\n'
              '    _focusNode.dispose();\n'
              '    super.dispose();\n'
              '  }\n'
              '\n'
              '  Future<void> _submit() async {\n'
              '    if (_submitting || _saved) return;\n'
              '    if (!mounted || !widget.origin.isValid) {\n'
              '      _dismissOwningDialog();\n'
              '      return;\n'
              '    }\n'
              '    final title = _titleController.text.trim();\n'
              '    if (title.isEmpty) return;\n'
              '    setState(() => _submitting = true);\n'
              '    try {\n'
              '      await context.read<TodoProvider>().addTodo(\n'
              '        TodoItem(\n'
              '          title: title,\n'
              '          date: widget.origin.selectedDay,\n'
              '          workspaceId: widget.origin.activeWorkspaceId ?? \'private\',\n'
              '        ),\n'
              '        waitForReminderSync: false,\n'
              '      );\n'
              '      if (!mounted) return;\n'
              '      if (!widget.origin.isValid) {\n'
              '        _saved = true;\n'
              '        _dismissOwningDialog();\n'
              '        return;\n'
              '      }\n'
              '      _saved = true;\n'
              '      _dismissOwningDialog();\n'
              '    } catch (e) {\n'
              '      if (!mounted) return;\n'
              '      if (!widget.origin.isValid) {\n'
              '        _dismissOwningDialog();\n'
              '        return;\n'
              '      }\n'
              '      setState(() => _submitting = false);\n'
              '      _showFeedbackError(context);\n'
              '    }\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final s = context.watch<ThemeProvider>().brand.strings;\n'
              '    return AppDialog(\n'
              '      title: Text(\n'
              '        CalendarUiCopy.quickAddTodoDialogTitle(\n'
              '          s.calendarQuickAddTitle,\n'
              '          widget.origin.selectedDay,\n'
              '        ),\n'
              '      ),\n'
              '      content: AppSecondaryControlTheme(\n'
              '        child: TextField(\n'
              '          controller: _titleController,\n'
              '          focusNode: _focusNode,\n'
              '          enabled: !_submitting && !_saved,\n'
              '          decoration: InputDecoration(labelText: CalendarUiCopy.todoTitleLabel),\n'
              '          autofocus: true,\n'
              '          onSubmitted: (_submitting || _saved) ? null : (_) => _submit(),\n'
              '        ),\n'
              '      ),\n'
              '      actions: [\n'
              '        TextButton(\n'
              '          onPressed: (_submitting || _saved) ? null : _dismissOwningDialog,\n'
              '          child: Text(I18n.tr(\'action.cancel\')),\n'
              '        ),\n'
              '        FilledButton(\n'
              '          onPressed: (_submitting || _saved) ? null : _submit,\n'
              '          child: _submitting\n'
              '              ? const SizedBox(\n'
              '                  width: 18,\n'
              '                  height: 18,\n'
              '                  child: CircularProgressIndicator(strokeWidth: 2),\n'
              '                )\n'
              '              : Text(I18n.tr(\'action.add\')),\n'
              '        ),\n'
              '      ],\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _QuickAddTimeEntryDialog extends StatefulWidget {\n'
              '  final _CalendarOriginScope origin;\n'
              '\n'
              '  const _QuickAddTimeEntryDialog({required this.origin});\n'
              '\n'
              '  @override\n'
              '  State<_QuickAddTimeEntryDialog> createState() =>\n'
              '      _QuickAddTimeEntryDialogState();\n'
              '}\n'
              '\n'
              'class _QuickAddTimeEntryDialogState extends State<_QuickAddTimeEntryDialog> {\n'
              '  late final TextEditingController _titleController;\n'
              '  late final TextEditingController _noteController;\n'
              '  late final TextEditingController _durationController;\n'
              '  late TimeOfDay _startTime;\n'
              '  TimeEntryCategory _category = TimeEntryCategory.work;\n'
              '  bool _submitting = false;\n'
              '  bool _saved = false;\n'
              '  ModalRoute<dynamic>? _owningRoute;\n'
              '  bool _originDismissalScheduled = false;\n'
              '\n'
              '  @override\n'
              '  void didChangeDependencies() {\n'
              '    super.didChangeDependencies();\n'
              '    _owningRoute ??= ModalRoute.of(context);\n'
              '  }\n'
              '\n'
              '  void _dismissOwningDialog() {\n'
              '    final route = _owningRoute ?? ModalRoute.of(context);\n'
              '    if (route != null && route.isActive) {\n'
              '      if (route.isCurrent) {\n'
              '        route.navigator?.pop();\n'
              '      } else {\n'
              '        route.navigator?.removeRoute(route);\n'
              '      }\n'
              '    }\n'
              '  }\n'
              '\n'
              '  void _showFeedbackError(BuildContext context) {\n'
              '    if (!context.mounted) return;\n'
              '    final messenger = ScaffoldMessenger.maybeOf(context);\n'
              '    if (messenger == null || !messenger.mounted) return;\n'
              '    messenger.showSnackBar(\n'
              '      const SnackBar(content: _CalendarFeedbackErrorText()),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  void initState() {\n'
              '    super.initState();\n'
              '    _titleController = TextEditingController();\n'
              '    _noteController = TextEditingController();\n'
              '    _durationController = TextEditingController(text: \'30\');\n'
              '    final now = DateTime.now();\n'
              '    _startTime = TimeOfDay.fromDateTime(\n'
              '      _isSameDay(widget.origin.selectedDay, now)\n'
              '          ? now\n'
              '          : DateTime(\n'
              '              widget.origin.selectedDay.year,\n'
              '              widget.origin.selectedDay.month,\n'
              '              widget.origin.selectedDay.day,\n'
              '              9,\n'
              '            ),\n'
              '    );\n'
              '    I18n.localeListenable.addListener(_onLocaleChanged);\n'
              '    AccountLocalDataCleaner.accountDataGenerationListenable.addListener(\n'
              '      _onOriginChanged,\n'
              '    );\n'
              '    widget.origin.callerAvailabilityListenable?.addListener(_onOriginChanged);\n'
              '  }\n'
              '\n'
              '  void _onOriginChanged() {\n'
              '    if (!mounted || widget.origin.isValid || _originDismissalScheduled) return;\n'
              '    _originDismissalScheduled = true;\n'
              '    WidgetsBinding.instance.addPostFrameCallback((_) {\n'
              '      _originDismissalScheduled = false;\n'
              '      if (!mounted || widget.origin.isValid) return;\n'
              '      _dismissOwningDialog();\n'
              '    });\n'
              '    WidgetsBinding.instance.scheduleFrame();\n'
              '  }\n'
              '\n'
              '  void _onLocaleChanged() {\n'
              '    if (mounted) setState(() {});\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  void dispose() {\n'
              '    I18n.localeListenable.removeListener(_onLocaleChanged);\n'
              '    AccountLocalDataCleaner.accountDataGenerationListenable.removeListener(\n'
              '      _onOriginChanged,\n'
              '    );\n'
              '    widget.origin.callerAvailabilityListenable?.removeListener(\n'
              '      _onOriginChanged,\n'
              '    );\n'
              '    _titleController.dispose();\n'
              '    _noteController.dispose();\n'
              '    _durationController.dispose();\n'
              '    super.dispose();\n'
              '  }\n'
              '\n'
              '  static bool _isSameDay(DateTime a, DateTime b) =>\n'
              '      a.year == b.year && a.month == b.month && a.day == b.day;\n'
              '\n'
              '  Future<void> _submit() async {\n'
              '    if (_submitting || _saved) return;\n'
              '    if (!mounted || !widget.origin.isValid) {\n'
              '      _dismissOwningDialog();\n'
              '      return;\n'
              '    }\n'
              '    final title = _titleController.text.trim();\n'
              '    final minutes = int.tryParse(_durationController.text.trim()) ?? 0;\n'
              '    if (title.isEmpty || minutes <= 0) return;\n'
              '    setState(() => _submitting = true);\n'
              '    try {\n'
              '      final start = DateTime(\n'
              '        widget.origin.selectedDay.year,\n'
              '        widget.origin.selectedDay.month,\n'
              '        widget.origin.selectedDay.day,\n'
              '        _startTime.hour,\n'
              '        _startTime.minute,\n'
              '      );\n'
              '      final end = start.add(Duration(minutes: minutes));\n'
              '      await context.read<TimeAuditProvider>().add(\n'
              '        TimeEntry(\n'
              '          title: title,\n'
              '          startAt: start,\n'
              '          endAt: end,\n'
              '          category: _category,\n'
              '          source: TimeEntrySource.manual,\n'
              '          note: _noteController.text.trim(),\n'
              '        ),\n'
              '      );\n'
              '      if (!mounted) return;\n'
              '      if (!widget.origin.isValid) {\n'
              '        _saved = true;\n'
              '        _dismissOwningDialog();\n'
              '        return;\n'
              '      }\n'
              '      _saved = true;\n'
              '      _dismissOwningDialog();\n'
              '    } catch (e) {\n'
              '      if (!mounted) return;\n'
              '      if (!widget.origin.isValid) {\n'
              '        _dismissOwningDialog();\n'
              '        return;\n'
              '      }\n'
              '      setState(() => _submitting = false);\n'
              '      _showFeedbackError(context);\n'
              '    }\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    return AppDialog(\n'
              '      title: Text(\n'
              '        CalendarUiCopy.quickAddTimeEntryDialogTitle(widget.origin.selectedDay),\n'
              '      ),\n'
              '      content: AppSecondaryControlTheme(\n'
              '        child: SingleChildScrollView(\n'
              '          child: Column(\n'
              '            mainAxisSize: MainAxisSize.min,\n'
              '            children: [\n'
              '              TextField(\n'
              '                controller: _titleController,\n'
              '                enabled: !_submitting && !_saved,\n'
              '                decoration: InputDecoration(\n'
              '                  labelText: CalendarUiCopy.timeEntryTitleLabel,\n'
              '                  prefixIcon: const Icon(Icons.title, size: 20),\n'
              '                ),\n'
              '                autofocus: true,\n'
              '              ),\n'
              '              const SizedBox(height: 12),\n'
              '              AppDropdownField<TimeEntryCategory>(\n'
              '                initialValue: _category,\n'
              '                labelText: CalendarUiCopy.timeEntryCategoryLabel,\n'
              '                prefixIcon: const Icon(Icons.label_outline, size: 20),\n'
              '                enabled: !_submitting && !_saved,\n'
              '                isInteractionAllowed: () {\n'
              '                  if (!mounted) return false;\n'
              '                  if (!widget.origin.isValid) {\n'
              '                    _dismissOwningDialog();\n'
              '                    return false;\n'
              '                  }\n'
              '                  return !_submitting && !_saved;\n'
              '                },\n'
              '                items: [\n'
              '                  for (final c in TimeEntryCategory.values)\n'
              '                    DropdownMenuItem(\n'
              '                      value: c,\n'
              '                      child: _LocaleAwareText(() => c.label),\n'
              '                    ),\n'
              '                ],\n'
              '                onChanged: (v) {\n'
              '                  if (!mounted ||\n'
              '                      !widget.origin.isValid ||\n'
              '                      _submitting ||\n'
              '                      _saved) {\n'
              '                    return;\n'
              '                  }\n'
              '                  if (v != null) setState(() => _category = v);\n'
              '                },\n'
              '              ),\n'
              '              const SizedBox(height: 12),\n'
              '              ListTile(\n'
              '                contentPadding: EdgeInsets.zero,\n'
              '                leading: const Icon(Icons.schedule),\n'
              '                title: Text(CalendarUiCopy.timeEntryStartTimeLabel),\n'
              '                subtitle: Text(AppTimePicker.format(_startTime)),\n'
              '                enabled: !_submitting && !_saved,\n'
              '                onTap: (_submitting || _saved)\n'
              '                    ? null\n'
              '                    : () async {\n'
              '                        if (!mounted || !widget.origin.isValid) {\n'
              '                          _dismissOwningDialog();\n'
              '                          return;\n'
              '                        }\n'
              '                        final picked = await AppTimePicker.show(\n'
              '                          context,\n'
              '                          initialTime: _startTime,\n'
              '                          titleKey: \'calendar.content.time_picker_start_time\',\n'
              '                          minuteStep: 5,\n'
              '                        );\n'
              '                        if (!mounted || !widget.origin.isValid) return;\n'
              '                        if (picked != null) {\n'
              '                          setState(() => _startTime = picked);\n'
              '                        }\n'
              '                      },\n'
              '              ),\n'
              '              const SizedBox(height: 8),\n'
              '              TextField(\n'
              '                controller: _durationController,\n'
              '                enabled: !_submitting && !_saved,\n'
              '                decoration: InputDecoration(\n'
              '                  labelText: CalendarUiCopy.timeEntryDurationLabel,\n'
              '                  prefixIcon: const Icon(Icons.timelapse, size: 20),\n'
              '                ),\n'
              '                keyboardType: TextInputType.number,\n'
              '              ),\n'
              '              const SizedBox(height: 12),\n'
              '              TextField(\n'
              '                controller: _noteController,\n'
              '                enabled: !_submitting && !_saved,\n'
              '                decoration: InputDecoration(\n'
              '                  labelText: CalendarUiCopy.timeEntryNoteLabel,\n'
              '                  prefixIcon: const Icon(Icons.notes_outlined, size: 20),\n'
              '                ),\n'
              '                maxLines: 2,\n'
              '              ),\n'
              '            ],\n'
              '          ),\n'
              '        ),\n'
              '      ),\n'
              '      actions: [\n'
              '        TextButton(\n'
              '          onPressed: (_submitting || _saved) ? null : _dismissOwningDialog,\n'
              '          child: Text(I18n.tr(\'action.cancel\')),\n'
              '        ),\n'
              '        FilledButton(\n'
              '          onPressed: (_submitting || _saved) ? null : _submit,\n'
              '          child: _submitting\n'
              '              ? const SizedBox(\n'
              '                  width: 18,\n'
              '                  height: 18,\n'
              '                  child: CircularProgressIndicator(strokeWidth: 2),\n'
              '                )\n'
              '              : Text(CalendarUiCopy.timeEntrySubmitButton),\n'
              '        ),\n'
              '      ],\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _QuickAddMenuSheet extends StatefulWidget {\n'
              '  final _CalendarOriginScope origin;\n'
              '  final VoidCallback onAiSchedule;\n'
              '  final VoidCallback onNewEvent;\n'
              '  final VoidCallback onNewTodo;\n'
              '  final VoidCallback onQuickAddTimeEntry;\n'
              '\n'
              '  const _QuickAddMenuSheet({\n'
              '    required this.origin,\n'
              '    required this.onAiSchedule,\n'
              '    required this.onNewEvent,\n'
              '    required this.onNewTodo,\n'
              '    required this.onQuickAddTimeEntry,\n'
              '  });\n'
              '\n'
              '  @override\n'
              '  State<_QuickAddMenuSheet> createState() => _QuickAddMenuSheetState();\n'
              '}\n'
              '\n'
              'class _QuickAddMenuSheetState extends State<_QuickAddMenuSheet> {\n'
              '  ModalRoute<dynamic>? _owningRoute;\n'
              '\n'
              '  @override\n'
              '  void didChangeDependencies() {\n'
              '    super.didChangeDependencies();\n'
              '    _owningRoute ??= ModalRoute.of(context);\n'
              '  }\n'
              '\n'
              '  void _dismissOwningSheet() {\n'
              '    final route = _owningRoute ?? ModalRoute.of(context);\n'
              '    if (route != null && route.isActive) {\n'
              '      if (route.isCurrent) {\n'
              '        route.navigator?.pop();\n'
              '      } else {\n'
              '        route.navigator?.removeRoute(route);\n'
              '      }\n'
              '    }\n'
              '  }\n'
              '\n'
              '  void _handleAction(VoidCallback callback) {\n'
              '    if (!mounted || !widget.origin.isValid) {\n'
              '      _dismissOwningSheet();\n'
              '      return;\n'
              '    }\n'
              '    _dismissOwningSheet();\n'
              '    callback();\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  void initState() {\n'
              '    super.initState();\n'
              '    I18n.localeListenable.addListener(_onLocaleChanged);\n'
              '  }\n'
              '\n'
              '  void _onLocaleChanged() {\n'
              '    if (mounted) setState(() {});\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  void dispose() {\n'
              '    I18n.localeListenable.removeListener(_onLocaleChanged);\n'
              '    super.dispose();\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    return AppModalSheet(\n'
              '      title: CalendarUiCopy.quickAddMenuTitle,\n'
              '      subtitle: CalendarUiCopy.quickAddMenuSubtitle,\n'
              '      maxWidth: 520,\n'
              '      child: Column(\n'
              '        mainAxisSize: MainAxisSize.min,\n'
              '        children: [\n'
              '          ListTile(\n'
              '            leading: const Icon(Icons.auto_awesome_outlined),\n'
              '            title: Text(CalendarUiCopy.quickAddAiScheduleTitle),\n'
              '            subtitle: Text(CalendarUiCopy.quickAddAiScheduleSubtitle),\n'
              '            onTap: () => _handleAction(widget.onAiSchedule),\n'
              '          ),\n'
              '          ListTile(\n'
              '            leading: const Icon(Icons.event_note_outlined),\n'
              '            title: Text(CalendarUiCopy.quickAddNewEventTitle),\n'
              '            subtitle: Text(CalendarUiCopy.quickAddNewEventSubtitle),\n'
              '            onTap: () => _handleAction(widget.onNewEvent),\n'
              '          ),\n'
              '          ListTile(\n'
              '            leading: const Icon(Icons.check_circle_outline),\n'
              '            title: Text(CalendarUiCopy.quickAddNewTodoTitle),\n'
              '            onTap: () => _handleAction(widget.onNewTodo),\n'
              '          ),\n'
              '          ListTile(\n'
              '            leading: const Icon(Icons.timelapse_outlined),\n'
              '            title: Text(CalendarUiCopy.quickAddTimeEntryTitle),\n'
              '            onTap: () => _handleAction(widget.onQuickAddTimeEntry),\n'
              '          ),\n'
              '        ],\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _ProjectDetailSheet extends StatefulWidget {\n'
              '  final _CalendarOriginScope origin;\n'
              '  final _CalendarProjectOption option;\n'
              '  final List<TodoItem> todos;\n'
              '\n'
              '  const _ProjectDetailSheet({\n'
              '    required this.origin,\n'
              '    required this.option,\n'
              '    required this.todos,\n'
              '  });\n'
              '\n'
              '  @override\n'
              '  State<_ProjectDetailSheet> createState() => _ProjectDetailSheetState();\n'
              '}\n'
              '\n'
              'class _ProjectDetailSheetState extends State<_ProjectDetailSheet> {\n'
              '  ModalRoute<dynamic>? _owningRoute;\n'
              '\n'
              '  @override\n'
              '  void didChangeDependencies() {\n'
              '    super.didChangeDependencies();\n'
              '    _owningRoute ??= ModalRoute.of(context);\n'
              '  }\n'
              '\n'
              '  void _dismissOwningSheet() {\n'
              '    final route = _owningRoute ?? ModalRoute.of(context);\n'
              '    if (route != null && route.isActive) {\n'
              '      if (route.isCurrent) {\n'
              '        route.navigator?.pop();\n'
              '      } else {\n'
              '        route.navigator?.removeRoute(route);\n'
              '      }\n'
              '    }\n'
              '  }\n'
              '\n'
              '  void _openTodoScreen() {\n'
              '    if (!mounted || !widget.origin.isValid) {\n'
              '      _dismissOwningSheet();\n'
              '      return;\n'
              '    }\n'
              '    _dismissOwningSheet();\n'
              '    Navigator.push(\n'
              '      context,\n'
              '      MaterialPageRoute(\n'
              '        builder: (_) => const BrandRouteSurface(child: TodoScreen()),\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  void initState() {\n'
              '    super.initState();\n'
              '    I18n.localeListenable.addListener(_onLocaleChanged);\n'
              '  }\n'
              '\n'
              '  void _onLocaleChanged() {\n'
              '    if (mounted) setState(() {});\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  void dispose() {\n'
              '    I18n.localeListenable.removeListener(_onLocaleChanged);\n'
              '    super.dispose();\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final today = DateTime.now();\n'
              '    final todayKey = DateTime(today.year, today.month, today.day);\n'
              '    final completed = widget.todos.where((todo) => todo.isCompleted).length;\n'
              '    final overdue = widget.todos.where((todo) => todo.isOverdue).length;\n'
              '    final todayCount = widget.todos.where((todo) {\n'
              '      final d = DateTime(todo.date.year, todo.date.month, todo.date.day);\n'
              '      return d == todayKey;\n'
              '    }).length;\n'
              '\n'
              '    return AppModalSheet(\n'
              '      title: CalendarUiCopy.projectDetailSheetTitle,\n'
              '      subtitle: widget.option.displayName,\n'
              '      maxWidth: 860,\n'
              '      scrollable: false,\n'
              '      child: LayoutBuilder(\n'
              '        builder: (context, constraints) {\n'
              '          final sheetHeight = (MediaQuery.sizeOf(context).height * 0.68).clamp(\n'
              '            360.0,\n'
              '            680.0,\n'
              '          );\n'
              '          return SizedBox(\n'
              '            height: sheetHeight,\n'
              '            child: Column(\n'
              '              mainAxisSize: MainAxisSize.min,\n'
              '              children: [\n'
              '                LayoutBuilder(\n'
              '                  builder: (context, constraints) {\n'
              '                    final itemWidth = constraints.maxWidth >= 640\n'
              '                        ? (constraints.maxWidth - 36) / 4\n'
              '                        : (constraints.maxWidth - 12) / 2;\n'
              '                    return Wrap(\n'
              '                      spacing: 12,\n'
              '                      runSpacing: 12,\n'
              '                      children: [\n'
              '                        SizedBox(\n'
              '                          width: itemWidth,\n'
              '                          child: _ProjectStat(\n'
              '                            label: CalendarUiCopy.projectStatTotal,\n'
              '                            value: \'${widget.todos.length}\',\n'
              '                          ),\n'
              '                        ),\n'
              '                        SizedBox(\n'
              '                          width: itemWidth,\n'
              '                          child: _ProjectStat(\n'
              '                            label: CalendarUiCopy.projectStatCompleted,\n'
              '                            value: \'$completed\',\n'
              '                          ),\n'
              '                        ),\n'
              '                        SizedBox(\n'
              '                          width: itemWidth,\n'
              '                          child: _ProjectStat(\n'
              '                            label: CalendarUiCopy.projectStatOverdue,\n'
              '                            value: \'$overdue\',\n'
              '                          ),\n'
              '                        ),\n'
              '                        SizedBox(\n'
              '                          width: itemWidth,\n'
              '                          child: _ProjectStat(\n'
              '                            label: CalendarUiCopy.projectStatToday,\n'
              '                            value: \'$todayCount\',\n'
              '                          ),\n'
              '                        ),\n'
              '                      ],\n'
              '                    );\n'
              '                  },\n'
              '                ),\n'
              '                const SizedBox(height: 12),\n'
              '                Expanded(\n'
              '                  child: widget.todos.isEmpty\n'
              '                      ? Center(child: Text(CalendarUiCopy.projectEmptyTasks))\n'
              '                      : Scrollbar(\n'
              '                          child: ListView.separated(\n'
              '                            key: const ValueKey(\n'
              '                              \'calendar_project_detail_scroll_region\',\n'
              '                            ),\n'
              '                            primary: false,\n'
              '                            padding: EdgeInsets.zero,\n'
              '                            itemCount: widget.todos.length,\n'
              '                            separatorBuilder: (_, _) =>\n'
              '                                const Divider(height: 1),\n'
              '                            itemBuilder: (context, index) {\n'
              '                              final todo = widget.todos[index];\n'
              '                              final visual =\n'
              '                                  CompletionVisibilityPolicy.visualState(todo);\n'
              '                              final isCompleted =\n'
              '                                  visual == TodoVisualState.completed;\n'
              '                              final isOverdue =\n'
              '                                  visual == TodoVisualState.overdue;\n'
              '                              final statusColor = isCompleted\n'
              '                                  ? Theme.of(context).colorScheme.tertiary\n'
              '                                  : isOverdue\n'
              '                                  ? Theme.of(context).colorScheme.error\n'
              '                                  : null;\n'
              '                              return ListTile(\n'
              '                                dense: true,\n'
              '                                visualDensity: VisualDensity.compact,\n'
              '                                contentPadding: EdgeInsets.zero,\n'
              '                                leading: Icon(\n'
              '                                  isCompleted\n'
              '                                      ? Icons.check_circle\n'
              '                                      : isOverdue\n'
              '                                      ? Icons.priority_high_rounded\n'
              '                                      : Icons.radio_button_unchecked,\n'
              '                                  size: 18,\n'
              '                                  color: statusColor,\n'
              '                                ),\n'
              '                                title: Text(\n'
              '                                  todo.title,\n'
              '                                  maxLines: 1,\n'
              '                                  overflow: TextOverflow.ellipsis,\n'
              '                                  style: TextStyle(\n'
              '                                    color: isCompleted\n'
              '                                        ? Theme.of(\n'
              '                                            context,\n'
              '                                          ).colorScheme.onSurfaceVariant\n'
              '                                        : isOverdue\n'
              '                                        ? Theme.of(context).colorScheme.error\n'
              '                                        : null,\n'
              '                                    decoration: isCompleted\n'
              '                                        ? TextDecoration.lineThrough\n'
              '                                        : null,\n'
              '                                  ),\n'
              '                                ),\n'
              '                                subtitle: Wrap(\n'
              '                                  spacing: 6,\n'
              '                                  runSpacing: 4,\n'
              '                                  crossAxisAlignment: WrapCrossAlignment.center,\n'
              '                                  children: [\n'
              '                                    Text(\n'
              '                                      \'${todo.date.month}/${todo.date.day}${todo.priority != TodoPriority.none ? \' · ${todo.priority.label}\' : \'\'}\',\n'
              '                                      style: const TextStyle(fontSize: 11),\n'
              '                                    ),\n'
              '                                    if (statusColor != null)\n'
              '                                      Text(\n'
              '                                        isCompleted\n'
              '                                            ? MainUiCopy.calendarStatusCompleted\n'
              '                                            : MainUiCopy.calendarStatusOverdue,\n'
              '                                        style: TextStyle(\n'
              '                                          fontSize: 11,\n'
              '                                          color: statusColor,\n'
              '                                        ),\n'
              '                                      ),\n'
              '                                  ],\n'
              '                                ),\n'
              '                              );\n'
              '                            },\n'
              '                          ),\n'
              '                        ),\n'
              '                ),\n'
              '                const SizedBox(height: 10),\n'
              '                Align(\n'
              '                  alignment: Alignment.centerRight,\n'
              '                  child: FilledButton.tonalIcon(\n'
              '                    onPressed: _openTodoScreen,\n'
              '                    icon: const Icon(Icons.open_in_new),\n'
              '                    label: Text(CalendarUiCopy.openTodoScreenButton),\n'
              '                  ),\n'
              '                ),\n'
              '              ],\n'
              '            ),\n'
              '          );\n'
              '        },\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _ProjectStat extends StatelessWidget {\n'
              '  final String label;\n'
              '  final String value;\n'
              '\n'
              '  const _ProjectStat({required this.label, required this.value});\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final cs = Theme.of(context).colorScheme;\n'
              '    return AppSurfaceCard(\n'
              '      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),\n'
              '      color: cs.surfaceContainerHighest.withValues(alpha: 0.45),\n'
              '      borderRadius: BorderRadius.circular(12),\n'
              '      child: Column(\n'
              '        children: [\n'
              '          Text(\n'
              '            value,\n'
              '            style: TextStyle(\n'
              '              fontSize: 18,\n'
              '              fontWeight: FontWeight.normal,\n'
              '              color: cs.primary,\n'
              '            ),\n'
              '          ),\n'
              '          const SizedBox(height: 2),\n'
              '          Text(\n'
              '            label,\n'
              '            style: TextStyle(fontSize: 11, color: cs.onSurfaceVariant),\n'
              '          ),\n'
              '        ],\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _CalendarNavigationHeader extends StatelessWidget {\n'
              '  final int tabIndex;\n'
              '  final String monthLabel;\n'
              '  final String weekLabel;\n'
              '  final String dayLabel;\n'
              '  final String threeDayLabel;\n'
              '  final String yearLabel;\n'
              '  final VoidCallback onPreviousMonth;\n'
              '  final VoidCallback onNextMonth;\n'
              '  final VoidCallback onPreviousWeek;\n'
              '  final VoidCallback onNextWeek;\n'
              '  final VoidCallback onPreviousDay;\n'
              '  final VoidCallback onNextDay;\n'
              '  final VoidCallback onPreviousThreeDays;\n'
              '  final VoidCallback onNextThreeDays;\n'
              '  final VoidCallback onPreviousYear;\n'
              '  final VoidCallback onNextYear;\n'
              '  final VoidCallback onPickDate;\n'
              '\n'
              '  const _CalendarNavigationHeader({\n'
              '    required this.tabIndex,\n'
              '    required this.monthLabel,\n'
              '    required this.weekLabel,\n'
              '    required this.dayLabel,\n'
              '    required this.threeDayLabel,\n'
              '    required this.yearLabel,\n'
              '    required this.onPreviousMonth,\n'
              '    required this.onNextMonth,\n'
              '    required this.onPreviousWeek,\n'
              '    required this.onNextWeek,\n'
              '    required this.onPreviousDay,\n'
              '    required this.onNextDay,\n'
              '    required this.onPreviousThreeDays,\n'
              '    required this.onNextThreeDays,\n'
              '    required this.onPreviousYear,\n'
              '    required this.onNextYear,\n'
