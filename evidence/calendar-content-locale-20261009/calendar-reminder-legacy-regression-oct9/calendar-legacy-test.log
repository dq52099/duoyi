              '\n'
              '  List<_CalendarProjectOption> _projectOptions(List<TodoItem> todos) {\n'
              '    final options = <_CalendarProjectOption>[];\n'
              '    for (final todo in todos) {\n'
              '      final trimmedName = todo.listGroupName?.trim();\n'
              '      final hasGroupName = trimmedName != null && trimmedName.isNotEmpty;\n'
              '      final key = todo.listGroupId?.isNotEmpty == true\n'
              '          ? todo.listGroupId!\n'
              '          : (hasGroupName ? trimmedName : \'\');\n'
              '      final name = hasGroupName ? trimmedName : \'\';\n'
              '      final index = options.indexWhere((option) => option.key == key);\n'
              '      if (index == -1) {\n'
              '        options.add(_CalendarProjectOption(key: key, name: name, count: 1));\n'
              '      } else {\n'
              '        final current = options[index];\n'
              '        options[index] = _CalendarProjectOption(\n'
              '          key: current.key,\n'
              '          name: current.name.isNotEmpty ? current.name : name,\n'
              '          count: current.count + 1,\n'
              '        );\n'
              '      }\n'
              '    }\n'
              '    options.sort((a, b) {\n'
              '      if (a.key.isEmpty) return 1;\n'
              '      if (b.key.isEmpty) return -1;\n'
              '      return a.displayName.compareTo(b.displayName);\n'
              '    });\n'
              '    return options;\n'
              '  }\n'
              '\n'
              '  List<_CalendarWorkspaceOption> _workspaceOptions(\n'
              '    List<TodoItem> todos,\n'
              '    List<GoalItem> goals,\n'
              '    List<CalendarEvent> localEvents,\n'
              '    List<Workspace> workspaces,\n'
              '  ) {\n'
              '    final counts = <String, int>{};\n'
              '    void addCount(String? rawWorkspaceId) {\n'
              '      final workspaceId =\n'
              '          rawWorkspaceId == null || rawWorkspaceId.trim().isEmpty\n'
              '          ? \'private\'\n'
              '          : rawWorkspaceId.trim();\n'
              '      counts[workspaceId] = (counts[workspaceId] ?? 0) + 1;\n'
              '    }\n'
              '\n'
              '    for (final todo in todos) {\n'
              '      addCount(todo.workspaceId);\n'
              '    }\n'
              '    for (final goal in goals) {\n'
              '      addCount(goal.workspaceId);\n'
              '    }\n'
              '    for (final event in localEvents) {\n'
              '      addCount(event.workspaceId);\n'
              '    }\n'
              '    final options = <_CalendarWorkspaceOption>[];\n'
              '    final privateCount = counts.remove(\'private\');\n'
              '    final knownWorkspaceIds = <String>{};\n'
              '    for (final workspace in workspaces) {\n'
              '      if (workspace.isPrivate) continue;\n'
              '      knownWorkspaceIds.add(workspace.id);\n'
              '    }\n'
              '    for (final workspace in workspaces) {\n'
              '      if (workspace.isPrivate) continue;\n'
              '      options.add(\n'
              '        _CalendarWorkspaceOption(\n'
              '          id: workspace.id,\n'
              '          name: workspace.name,\n'
              '          count: counts[workspace.id] ?? 0,\n'
              '          isPrivate: false,\n'
              '        ),\n'
              '      );\n'
              '    }\n'
              '    for (final entry in counts.entries) {\n'
              '      if (knownWorkspaceIds.contains(entry.key)) continue;\n'
              '      Workspace? workspace;\n'
              '      for (final item in workspaces) {\n'
              '        if (item.id == entry.key) {\n'
              '          workspace = item;\n'
              '          break;\n'
              '        }\n'
              '      }\n'
              '      options.add(\n'
              '        _CalendarWorkspaceOption(\n'
              '          id: entry.key,\n'
              '          name: workspace?.name ?? \'\',\n'
              '          count: entry.value,\n'
              '          isPrivate: false,\n'
              '          isFallbackShared: workspace == null || workspace.name.isEmpty,\n'
              '        ),\n'
              '      );\n'
              '    }\n'
              '    if (privateCount != null && privateCount > 0) {\n'
              '      options.add(\n'
              '        _CalendarWorkspaceOption(\n'
              '          id: \'private\',\n'
              '          name: \'\',\n'
              '          count: privateCount,\n'
              '          isPrivate: true,\n'
              '        ),\n'
              '      );\n'
              '    }\n'
              '    if (!options.any((option) => !option.isPrivate)) {\n'
              '      return const <_CalendarWorkspaceOption>[];\n'
              '    }\n'
              '    options.sort((a, b) {\n'
              '      if (a.isPrivate && !b.isPrivate) return 1;\n'
              '      if (!a.isPrivate && b.isPrivate) return -1;\n'
              '      return a.displayName.compareTo(b.displayName);\n'
              '    });\n'
              '    return options;\n'
              '  }\n'
              '\n'
              '  List<TodoItem> _projectTodos(List<TodoItem> todos, String projectKey) {\n'
              '    return todos.where((todo) {\n'
              '      final trimmedName = todo.listGroupName?.trim();\n'
              '      final key = todo.listGroupId?.isNotEmpty == true\n'
              '          ? todo.listGroupId!\n'
              '          : (trimmedName == null || trimmedName.isEmpty ? \'\' : trimmedName);\n'
              '      return key == projectKey;\n'
              '    }).toList();\n'
              '  }\n'
              '\n'
              '  List<TodoItem> _workspaceTodos(List<TodoItem> todos, String? workspaceId) {\n'
              '    if (workspaceId == null) return todos;\n'
              '    return todos.where((todo) {\n'
              '      final todoWorkspaceId = todo.workspaceId.trim().isEmpty\n'
              '          ? \'private\'\n'
              '          : todo.workspaceId.trim();\n'
              '      return todoWorkspaceId == workspaceId;\n'
              '    }).toList();\n'
              '  }\n'
              '\n'
              '  _CalendarOriginScope _createOriginScope() {\n'
              '    return _CalendarOriginScope(\n'
              '      accountGeneration: AccountLocalDataCleaner.accountDataGeneration,\n'
              '      selectedDay: _selectedDay,\n'
              '      activeWorkspaceId: _activeWorkspaceId,\n'
              '      isCallerActive: () => mounted && !_callerLifecycleNotifier._isDisposed,\n'
              '      callerAvailabilityListenable: _callerLifecycleNotifier,\n'
              '    );\n'
              '  }\n'
              '\n'
              '  Future<void> _showProjectDetail(\n'
              '    BuildContext context,\n'
              '    _CalendarProjectOption option,\n'
              '    List<TodoItem> todos,\n'
              '  ) {\n'
              '    final origin = _createOriginScope();\n'
              '    return showAppModalSheet<void>(\n'
              '      context: context,\n'
              '      builder: (_) =>\n'
              '          _ProjectDetailSheet(origin: origin, option: option, todos: todos),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  void _showQuickAddMenu(BuildContext context) {\n'
              '    final routeContext = context;\n'
              '    final origin = _createOriginScope();\n'
              '    showAppModalSheet<void>(\n'
              '      context: context,\n'
              '      builder: (_) => _QuickAddMenuSheet(\n'
              '        origin: origin,\n'
              '        onAiSchedule: () {\n'
              '          if (!origin.isValid) return;\n'
              '          Navigator.push(\n'
              '            routeContext,\n'
              '            MaterialPageRoute(\n'
              '              builder: (_) => BrandRouteSurface(\n'
              '                child: AiScheduleScreen(initialDate: origin.selectedDay),\n'
              '              ),\n'
              '            ),\n'
              '          );\n'
              '        },\n'
              '        onNewEvent: () {\n'
              '          if (!origin.isValid) return;\n'
              '          showLocalCalendarEventEditor(\n'
              '            routeContext,\n'
              '            initialDate: origin.selectedDay,\n'
              '            workspaceId: origin.activeWorkspaceId,\n'
              '          );\n'
              '        },\n'
              '        onNewTodo: () {\n'
              '          if (!origin.isValid) return;\n'
              '          _showQuickAddTodo(origin: origin);\n'
              '        },\n'
              '        onQuickAddTimeEntry: () {\n'
              '          if (!origin.isValid) return;\n'
              '          _showQuickAddTimeEntry(origin: origin);\n'
              '        },\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  Future<void> _showQuickAddTimeEntry({_CalendarOriginScope? origin}) async {\n'
              '    final effectiveOrigin = origin ?? _createOriginScope();\n'
              '    if (!effectiveOrigin.isValid) return;\n'
              '    await showDialog<void>(\n'
              '      context: context,\n'
              '      builder: (_) => _QuickAddTimeEntryDialog(origin: effectiveOrigin),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _CallerLifecycleNotifier implements Listenable {\n'
              '  final List<VoidCallback> _listeners = [];\n'
              '  bool _isDisposed = false;\n'
              '\n'
              '  void notifyCallerDisposed() {\n'
              '    if (_isDisposed) return;\n'
              '    _isDisposed = true;\n'
              '    final copy = List<VoidCallback>.from(_listeners);\n'
              '    for (final listener in copy) {\n'
              '      listener();\n'
              '    }\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  void addListener(VoidCallback listener) {\n'
              '    if (_isDisposed) {\n'
              '      listener();\n'
              '      return;\n'
              '    }\n'
              '    _listeners.add(listener);\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  void removeListener(VoidCallback listener) {\n'
              '    _listeners.remove(listener);\n'
              '  }\n'
              '}\n'
              '\n'
              'class _CalendarOriginScope {\n'
              '  final int accountGeneration;\n'
              '  final DateTime selectedDay;\n'
              '  final String? activeWorkspaceId;\n'
              '  final bool Function() isCallerActive;\n'
              '  final Listenable? callerAvailabilityListenable;\n'
              '\n'
              '  const _CalendarOriginScope({\n'
              '    required this.accountGeneration,\n'
              '    required this.selectedDay,\n'
              '    required this.activeWorkspaceId,\n'
              '    required this.isCallerActive,\n'
              '    this.callerAvailabilityListenable,\n'
              '  });\n'
              '\n'
              '  bool get isValid =>\n'
              '      isCallerActive() &&\n'
              '      AccountLocalDataCleaner.isCurrentAccountDataGeneration(accountGeneration);\n'
              '}\n'
              '\n'
              'class _CalendarFeedbackErrorText extends StatelessWidget {\n'
              '  const _CalendarFeedbackErrorText();\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    return ValueListenableBuilder<AppLocale>(\n'
              '      valueListenable: I18n.localeListenable,\n'
              '      builder: (context, _, _) => Text(CalendarUiCopy.saveFailed),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _LocaleAwareText extends StatelessWidget {\n'
              '  final String Function() textBuilder;\n'
              '\n'
              '  const _LocaleAwareText(this.textBuilder);\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    return ValueListenableBuilder<AppLocale>(\n'
              '      valueListenable: I18n.localeListenable,\n'
              '      builder: (context, _, _) => Text(textBuilder()),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _LocaleAwareSecondaryMenuText extends StatelessWidget {\n'
              '  final String Function() textBuilder;\n'
              '\n'
              '  const _LocaleAwareSecondaryMenuText(this.textBuilder);\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    return ValueListenableBuilder<AppLocale>(\n'
              '      valueListenable: I18n.localeListenable,\n'
              '      builder: (context, _, _) => AppSecondaryMenuText(textBuilder()),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _CalendarProjectOption {\n'
              '  final String key;\n'
              '  final String name;\n'
              '  final int count;\n'
              '\n'
              '  const _CalendarProjectOption({\n'
              '    required this.key,\n'
              '    required this.name,\n'
              '    required this.count,\n'
              '  });\n'
              '\n'
              '  String get displayName =>\n'
              '      key.isEmpty || name.isEmpty ? CalendarUiCopy.ungroupedProject : name;\n'
              '}\n'
              '\n'
              'class _CalendarWorkspaceOption {\n'
              '  final String id;\n'
              '  final String name;\n'
