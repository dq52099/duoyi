              '\n'
              'class _CalendarNavigationHeader extends StatelessWidget {\n'
              '  final int tabIndex;\n'
              '  final String monthLabel;\n'
              '  final String weekLabel;\n'
              '  final String dayLabel;\n'
              '  final String threeDayLabel;\n'
              '  final String yearLabel;\n'
              '  final VoidCallback onPreviousMonth;\n'
              '  final VoidCallback onNextMonth;\n'
              '  final VoidCallback onPreviousWeek;\n'
              '  final VoidCallback onNextWeek;\n'
              '  final VoidCallback onPreviousDay;\n'
              '  final VoidCallback onNextDay;\n'
              '  final VoidCallback onPreviousThreeDays;\n'
              '  final VoidCallback onNextThreeDays;\n'
              '  final VoidCallback onPreviousYear;\n'
              '  final VoidCallback onNextYear;\n'
              '  final VoidCallback onPickDate;\n'
              '\n'
              '  const _CalendarNavigationHeader({\n'
              '    required this.tabIndex,\n'
              '    required this.monthLabel,\n'
              '    required this.weekLabel,\n'
              '    required this.dayLabel,\n'
              '    required this.threeDayLabel,\n'
              '    required this.yearLabel,\n'
              '    required this.onPreviousMonth,\n'
              '    required this.onNextMonth,\n'
              '    required this.onPreviousWeek,\n'
              '    required this.onNextWeek,\n'
              '    required this.onPreviousDay,\n'
              '    required this.onNextDay,\n'
              '    required this.onPreviousThreeDays,\n'
              '    required this.onNextThreeDays,\n'
              '    required this.onPreviousYear,\n'
              '    required this.onNextYear,\n'
              '    required this.onPickDate,\n'
              '  });\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final cs = Theme.of(context).colorScheme;\n'
              '    final label = switch (tabIndex) {\n'
              '      0 => monthLabel,\n'
              '      1 => weekLabel,\n'
              '      2 => dayLabel,\n'
              '      3 => threeDayLabel,\n'
              '      4 => yearLabel,\n'
              '      _ => dayLabel,\n'
              '    };\n'
              '    final previous = switch (tabIndex) {\n'
              '      0 => onPreviousMonth,\n'
              '      1 => onPreviousWeek,\n'
              '      2 => onPreviousDay,\n'
              '      3 => onPreviousThreeDays,\n'
              '      4 => onPreviousYear,\n'
              '      _ => null,\n'
              '    };\n'
              '    final next = switch (tabIndex) {\n'
              '      0 => onNextMonth,\n'
              '      1 => onNextWeek,\n'
              '      2 => onNextDay,\n'
              '      3 => onNextThreeDays,\n'
              '      4 => onNextYear,\n'
              '      _ => null,\n'
              '    };\n'
              '    final previousTooltip = switch (tabIndex) {\n'
              '      0 => MainUiCopy.calendarPrevMonth,\n'
              '      1 => MainUiCopy.calendarPrevWeek,\n'
              '      2 => MainUiCopy.calendarPrevDay,\n'
              '      3 => MainUiCopy.calendarPrevThreeDays,\n'
              '      4 => MainUiCopy.calendarPrevYear,\n'
              '      _ => MainUiCopy.calendarPrevDay,\n'
              '    };\n'
              '    final nextTooltip = switch (tabIndex) {\n'
              '      0 => MainUiCopy.calendarNextMonth,\n'
              '      1 => MainUiCopy.calendarNextWeek,\n'
              '      2 => MainUiCopy.calendarNextDay,\n'
              '      3 => MainUiCopy.calendarNextThreeDays,\n'
              '      4 => MainUiCopy.calendarNextYear,\n'
              '      _ => MainUiCopy.calendarNextDay,\n'
              '    };\n'
              '\n'
              '    return Material(\n'
              '      color: cs.surface,\n'
              '      child: LayoutBuilder(\n'
              '        builder: (context, constraints) {\n'
              '          final compact = constraints.maxWidth < 390;\n'
              '          return Padding(\n'
              '            padding: EdgeInsets.fromLTRB(\n'
              '              compact ? 5 : 8,\n'
              '              5,\n'
              '              compact ? 5 : 8,\n'
              '              6,\n'
              '            ),\n'
              '            child: SizedBox(\n'
              '              height: compact ? 62 : 68,\n'
              '              child: DecoratedBox(\n'
              '                key: const ValueKey(\'calendar_navigation_header_bar\'),\n'
              '                decoration: BoxDecoration(\n'
              '                  color: cs.surfaceContainerHighest.withValues(alpha: 0.42),\n'
              '                  borderRadius: BorderRadius.circular(DesignTokens.radiusCard),\n'
              '                  border: Border.all(\n'
              '                    color: cs.outlineVariant.withValues(alpha: 0.10),\n'
              '                    width: 0.45,\n'
              '                  ),\n'
              '                ),\n'
              '                child: Padding(\n'
              '                  padding: EdgeInsets.all(compact ? 4 : 5),\n'
              '                  child: Row(\n'
              '                    children: [\n'
              '                      _NavIconButton(\n'
              '                        icon: Icons.chevron_left,\n'
              '                        onPressed: previous,\n'
              '                        tooltip: previousTooltip,\n'
              '                        dimension: 48,\n'
              '                      ),\n'
              '                      SizedBox(width: compact ? 3 : 4),\n'
              '                      Expanded(\n'
              '                        child: FilledButton(\n'
              '                          key: const ValueKey(\n'
              '                            \'calendar_navigation_date_button\',\n'
              '                          ),\n'
              '                          onPressed: onPickDate,\n'
              '                          style: FilledButton.styleFrom(\n'
              '                            foregroundColor: cs.onSurface,\n'
              '                            backgroundColor: Color.alphaBlend(\n'
              '                              cs.primary.withValues(alpha: 0.10),\n'
              '                              cs.surface,\n'
              '                            ),\n'
              '                            minimumSize: compact\n'
              '                                ? const Size(0, 52)\n'
              '                                : const Size(double.infinity, 56),\n'
              '                            padding: EdgeInsets.symmetric(\n'
              '                              horizontal: compact ? 8 : 14,\n'
              '                            ),\n'
              '                            shape: RoundedRectangleBorder(\n'
              '                              borderRadius: BorderRadius.circular(16),\n'
              '                              side: BorderSide(\n'
              '                                color: cs.primary.withValues(alpha: 0.10),\n'
              '                                width: 0.45,\n'
              '                              ),\n'
              '                            ),\n'
              '                            textStyle: Theme.of(context).textTheme.labelLarge\n'
              '                                ?.copyWith(\n'
              '                                  fontSize: compact ? 12.5 : 13.5,\n'
              '                                  fontWeight: FontWeight.normal,\n'
              '                                  height: 1.15,\n'
              '                                ),\n'
              '                          ),\n'
              '                          child: Row(\n'
              '                            mainAxisAlignment: MainAxisAlignment.center,\n'
              '                            mainAxisSize: MainAxisSize.min,\n'
              '                            children: [\n'
              '                              if (!compact) ...[\n'
              '                                const Icon(\n'
              '                                  Icons.calendar_month_outlined,\n'
              '                                  size: 16,\n'
              '                                ),\n'
              '                                const SizedBox(width: 6),\n'
              '                              ],\n'
              '                              Flexible(\n'
              '                                child: Text(\n'
              '                                  label,\n'
              '                                  textAlign: TextAlign.center,\n'
              '                                  overflow: TextOverflow.ellipsis,\n'
              '                                  maxLines: 2,\n'
              '                                ),\n'
              '                              ),\n'
              '                            ],\n'
              '                          ),\n'
              '                        ),\n'
              '                      ),\n'
              '                      SizedBox(width: compact ? 3 : 4),\n'
              '                      _NavIconButton(\n'
              '                        icon: Icons.chevron_right,\n'
              '                        onPressed: next,\n'
              '                        tooltip: nextTooltip,\n'
              '                        dimension: 48,\n'
              '                      ),\n'
              '                    ],\n'
              '                  ),\n'
              '                ),\n'
              '              ),\n'
              '            ),\n'
              '          );\n'
              '        },\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _NavIconButton extends StatelessWidget {\n'
              '  final IconData icon;\n'
              '  final VoidCallback? onPressed;\n'
              '  final String tooltip;\n'
              '  final double dimension;\n'
              '\n'
              '  const _NavIconButton({\n'
              '    required this.icon,\n'
              '    required this.onPressed,\n'
              '    required this.tooltip,\n'
              '    this.dimension = 44,\n'
              '  });\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    return SizedBox.square(\n'
              '      dimension: dimension,\n'
              '      child: IconButton(\n'
              '        tooltip: tooltip,\n'
              '        padding: EdgeInsets.zero,\n'
              '        iconSize: dimension <= 34 ? 19 : 20,\n'
              '        visualDensity: VisualDensity.compact,\n'
              '        style: IconButton.styleFrom(\n'
              '          fixedSize: Size.square(dimension),\n'
              '          minimumSize: Size.square(dimension),\n'
              '          tapTargetSize: MaterialTapTargetSize.padded,\n'
              '        ),\n'
              '        icon: Icon(icon),\n'
              '        onPressed: onPressed,\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _CalendarThreeDayView extends StatelessWidget {\n'
              '  final DateTime startDate;\n'
              '  final CalendarProvider calendarProvider;\n'
              '  final Set<CalendarEventType>? activeTypes;\n'
              '  final String? projectKey;\n'
              '  final String? workspaceId;\n'
              '  final bool hasActiveFilters;\n'
              '\n'
              '  const _CalendarThreeDayView({\n'
              '    super.key,\n'
              '    required this.startDate,\n'
              '    required this.calendarProvider,\n'
              '    this.activeTypes,\n'
              '    this.projectKey,\n'
              '    this.workspaceId,\n'
              '    required this.hasActiveFilters,\n'
              '  });\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final days = List.generate(\n'
              '      3,\n'
              '      (index) => startDate.add(Duration(days: index)),\n'
              '    );\n'
              '    return LayoutBuilder(\n'
              '      builder: (context, constraints) {\n'
              '        if (constraints.maxWidth >= 900) {\n'
              '          return Row(\n'
              '            crossAxisAlignment: CrossAxisAlignment.stretch,\n'
              '            children: [\n'
              '              for (var i = 0; i < days.length; i++) ...[\n'
              '                Expanded(\n'
              '                  child: _ThreeDayLane(\n'
              '                    date: days[i],\n'
              '                    calendarProvider: calendarProvider,\n'
              '                    activeTypes: activeTypes,\n'
              '                    projectKey: projectKey,\n'
              '                    workspaceId: workspaceId,\n'
              '                    hasActiveFilters: hasActiveFilters,\n'
              '                  ),\n'
              '                ),\n'
              '                if (i != days.length - 1)\n'
              '                  VerticalDivider(\n'
              '                    width: 1,\n'
              '                    thickness: 0.5,\n'
              '                    color: Theme.of(\n'
              '                      context,\n'
              '                    ).colorScheme.outlineVariant.withValues(alpha: 0.16),\n'
              '                  ),\n'
              '              ],\n'
              '            ],\n'
              '          );\n'
              '        }\n'
              '        return SingleChildScrollView(\n'
              '          scrollDirection: Axis.horizontal,\n'
              '          child: Row(\n'
              '            crossAxisAlignment: CrossAxisAlignment.stretch,\n'
              '            children: [\n'
              '              for (final day in days)\n'
              '                SizedBox(\n'
              '                  width: constraints.maxWidth < 390\n'
              '                      ? constraints.maxWidth\n'
              '                      : 380,\n'
              '                  child: _ThreeDayLane(\n'
              '                    date: day,\n'
              '                    calendarProvider: calendarProvider,\n'
              '                    activeTypes: activeTypes,\n'
              '                    projectKey: projectKey,\n'
              '                    workspaceId: workspaceId,\n'
              '                    hasActiveFilters: hasActiveFilters,\n'
              '                  ),\n'
              '                ),\n'
              '            ],\n'
              '          ),\n'
              '        );\n'
              '      },\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _ThreeDayLane extends StatelessWidget {\n'
              '  final DateTime date;\n'
              '  final CalendarProvider calendarProvider;\n'
              '  final Set<CalendarEventType>? activeTypes;\n'
              '  final String? projectKey;\n'
              '  final String? workspaceId;\n'
              '  final bool hasActiveFilters;\n'
              '\n'
              '  const _ThreeDayLane({\n'
              '    required this.date,\n'
              '    required this.calendarProvider,\n'
              '    this.activeTypes,\n'
              '    this.projectKey,\n'
              '    this.workspaceId,\n'
              '    required this.hasActiveFilters,\n'
              '  });\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final cs = Theme.of(context).colorScheme;\n'
              '    final events = calendarProvider.getEventsForDate(\n'
              '      date,\n'
              '      activeTypes: activeTypes,\n'
              '      projectKey: projectKey,\n'
              '      workspaceId: workspaceId,\n'
              '    );\n'
              '    return Column(\n'
              '      crossAxisAlignment: CrossAxisAlignment.stretch,\n'
              '      children: [\n'
              '        AppSurfaceCard(\n'
              '          key: ValueKey(\n'
              '            \'calendar_three_day_lane_skin_${date.toIso8601String()}\',\n'
              '          ),\n'
              '          margin: const EdgeInsets.fromLTRB(12, 8, 12, 0),\n'
              '          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),\n'
              '          borderRadius: BorderRadius.circular(12),\n'
              '          child: Row(\n'
              '            children: [\n'
              '              Icon(Icons.view_column_outlined, size: 16, color: cs.primary),\n'
              '              const SizedBox(width: 8),\n'
              '              Expanded(\n'
              '                child: Text(\n'
              '                  CalendarUiCopy.threeDayLaneHeader(date),\n'
              '                  overflow: TextOverflow.ellipsis,\n'
              '                  style: const TextStyle(\n'
              '                    fontSize: 13,\n'
              '                    fontWeight: FontWeight.normal,\n'
              '                  ),\n'
              '                ),\n'
              '              ),\n'
              '              const SizedBox(width: 4),\n'
              '              Text(\n'
              '                CalendarUiCopy.laneItemCount(events.length),\n'
              '                style: TextStyle(fontSize: 12, color: cs.onSurfaceVariant),\n'
              '              ),\n'
              '            ],\n'
              '          ),\n'
              '        ),\n'
              '        Expanded(\n'
              '          child: AppSurfaceCard(\n'
              '            margin: const EdgeInsets.fromLTRB(12, 8, 12, 12),\n'
              '            padding: EdgeInsets.zero,\n'
              '            borderRadius: BorderRadius.circular(12),\n'
              '            child: CalendarDayAgenda(\n'
              '              date: date,\n'
              '              calendarProvider: calendarProvider,\n'
              '              activeTypes: activeTypes,\n'
              '              projectKey: projectKey,\n'
              '              workspaceId: workspaceId,\n'
              '              hasActiveFilters: hasActiveFilters,\n'
              '              horizontalPadding: 8,\n'
              '            ),\n'
              '          ),\n'
              '        ),\n'
              '      ],\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _CalendarYearOverview extends StatelessWidget {\n'
              '  final int year;\n'
              '  final DateTime selectedDay;\n'
              '  final Map<String, List<CalendarEventType>> dateEventTypes;\n'
              '  final void Function(int month) onMonthTap;\n'
              '\n'
              '  const _CalendarYearOverview({\n'
              '    super.key,\n'
              '    required this.year,\n'
              '    required this.selectedDay,\n'
              '    required this.dateEventTypes,\n'
              '    required this.onMonthTap,\n'
              '  });\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final cs = Theme.of(context).colorScheme;\n'
              '    final months = List.generate(12, (i) => i + 1);\n'
              '    return GridView.builder(\n'
              '      padding: const EdgeInsets.fromLTRB(12, 8, 12, 12),\n'
              '      itemCount: months.length,\n'
              '      gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(\n'
              '        crossAxisCount: 2,\n'
              '        mainAxisSpacing: 10,\n'
              '        crossAxisSpacing: 10,\n'
              '        childAspectRatio: 1.28,\n'
              '      ),\n'
              '      itemBuilder: (context, index) {\n'
              '        final month = months[index];\n'
              '        final monthDays = _monthDays(year, month);\n'
              '        final eventCount = monthDays.fold<int>(0, (sum, d) {\n'
