              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    return ValueListenableBuilder<AppLocale>(\n'
              '      valueListenable: I18n.localeListenable,\n'
              '      builder: (context, _, _) => AppSecondaryMenuText(textBuilder()),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _CalendarProjectOption {\n'
              '  final String key;\n'
              '  final String name;\n'
              '  final int count;\n'
              '\n'
              '  const _CalendarProjectOption({\n'
              '    required this.key,\n'
              '    required this.name,\n'
              '    required this.count,\n'
              '  });\n'
              '\n'
              '  String get displayName =>\n'
              '      key.isEmpty || name.isEmpty ? CalendarUiCopy.ungroupedProject : name;\n'
              '}\n'
              '\n'
              'class _CalendarWorkspaceOption {\n'
              '  final String id;\n'
              '  final String name;\n'
              '  final int count;\n'
              '  final bool isPrivate;\n'
              '  final bool isFallbackShared;\n'
              '\n'
              '  const _CalendarWorkspaceOption({\n'
              '    required this.id,\n'
              '    required this.name,\n'
              '    required this.count,\n'
              '    required this.isPrivate,\n'
              '    this.isFallbackShared = false,\n'
              '  });\n'
              '\n'
              '  String get displayName {\n'
              '    if (isPrivate) return CalendarUiCopy.personalWorkspace;\n'
              '    if (isFallbackShared || name.isEmpty) return CalendarUiCopy.sharedWorkspace;\n'
              '    return name;\n'
              '  }\n'
              '}\n'
              '\n'
              'class _QuickAddTodoDialog extends StatefulWidget {\n'
              '  final _CalendarOriginScope origin;\n'
              '\n'
              '  const _QuickAddTodoDialog({required this.origin});\n'
              '\n'
              '  @override\n'
              '  State<_QuickAddTodoDialog> createState() => _QuickAddTodoDialogState();\n'
              '}\n'
              '\n'
              'class _QuickAddTodoDialogState extends State<_QuickAddTodoDialog> {\n'
              '  late final TextEditingController _titleController;\n'
              '  late final FocusNode _focusNode;\n'
              '  bool _submitting = false;\n'
              '  bool _saved = false;\n'
              '  ModalRoute<dynamic>? _owningRoute;\n'
              '\n'
              '  @override\n'
              '  void didChangeDependencies() {\n'
              '    super.didChangeDependencies();\n'
              '    _owningRoute ??= ModalRoute.of(context);\n'
              '  }\n'
              '\n'
              '  void _dismissOwningDialog() {\n'
              '    final route = _owningRoute ?? ModalRoute.of(context);\n'
              '    if (route != null && route.isActive) {\n'
              '      if (route.isCurrent) {\n'
              '        route.navigator?.pop();\n'
              '      } else {\n'
              '        route.navigator?.removeRoute(route);\n'
              '      }\n'
              '    }\n'
              '  }\n'
              '\n'
              '  void _showFeedbackError(BuildContext context) {\n'
              '    if (!context.mounted) return;\n'
              '    final messenger = ScaffoldMessenger.maybeOf(context);\n'
              '    if (messenger == null || !messenger.mounted) return;\n'
              '    messenger.showSnackBar(\n'
              '      const SnackBar(content: _CalendarFeedbackErrorText()),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  void initState() {\n'
              '    super.initState();\n'
              '    _titleController = TextEditingController();\n'
              '    _focusNode = FocusNode();\n'
              '    I18n.localeListenable.addListener(_onLocaleChanged);\n'
              '  }\n'
              '\n'
              '  void _onLocaleChanged() {\n'
              '    if (mounted) setState(() {});\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  void dispose() {\n'
              '    I18n.localeListenable.removeListener(_onLocaleChanged);\n'
              '    _titleController.dispose();\n'
              '    _focusNode.dispose();\n'
              '    super.dispose();\n'
              '  }\n'
              '\n'
              '  Future<void> _submit() async {\n'
              '    if (_submitting || _saved) return;\n'
              '    if (!mounted || !widget.origin.isValid) {\n'
              '      _dismissOwningDialog();\n'
              '      return;\n'
              '    }\n'
              '    final title = _titleController.text.trim();\n'
              '    if (title.isEmpty) return;\n'
              '    setState(() => _submitting = true);\n'
              '    try {\n'
              '      await context.read<TodoProvider>().addTodo(\n'
              '        TodoItem(\n'
              '          title: title,\n'
              '          date: widget.origin.selectedDay,\n'
              '          workspaceId: widget.origin.activeWorkspaceId ?? \'private\',\n'
              '        ),\n'
              '        waitForReminderSync: false,\n'
              '      );\n'
              '      if (!mounted) return;\n'
              '      if (!widget.origin.isValid) {\n'
              '        _saved = true;\n'
              '        _dismissOwningDialog();\n'
              '        return;\n'
              '      }\n'
              '      _saved = true;\n'
              '      _dismissOwningDialog();\n'
              '    } catch (e) {\n'
              '      if (!mounted) return;\n'
              '      if (!widget.origin.isValid) {\n'
              '        _dismissOwningDialog();\n'
              '        return;\n'
              '      }\n'
              '      setState(() => _submitting = false);\n'
              '      _showFeedbackError(context);\n'
              '    }\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final s = context.watch<ThemeProvider>().brand.strings;\n'
              '    return AppDialog(\n'
              '      title: Text(\n'
              '        CalendarUiCopy.quickAddTodoDialogTitle(\n'
              '          s.calendarQuickAddTitle,\n'
              '          widget.origin.selectedDay,\n'
              '        ),\n'
              '      ),\n'
              '      content: AppSecondaryControlTheme(\n'
              '        child: TextField(\n'
              '          controller: _titleController,\n'
              '          focusNode: _focusNode,\n'
              '          enabled: !_submitting && !_saved,\n'
              '          decoration: InputDecoration(labelText: CalendarUiCopy.todoTitleLabel),\n'
              '          autofocus: true,\n'
              '          onSubmitted: (_submitting || _saved) ? null : (_) => _submit(),\n'
              '        ),\n'
              '      ),\n'
              '      actions: [\n'
              '        TextButton(\n'
              '          onPressed: (_submitting || _saved) ? null : _dismissOwningDialog,\n'
              '          child: Text(I18n.tr(\'action.cancel\')),\n'
              '        ),\n'
              '        FilledButton(\n'
              '          onPressed: (_submitting || _saved) ? null : _submit,\n'
              '          child: _submitting\n'
              '              ? const SizedBox(\n'
              '                  width: 18,\n'
              '                  height: 18,\n'
              '                  child: CircularProgressIndicator(strokeWidth: 2),\n'
              '                )\n'
              '              : Text(I18n.tr(\'action.add\')),\n'
              '        ),\n'
              '      ],\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _QuickAddTimeEntryDialog extends StatefulWidget {\n'
              '  final _CalendarOriginScope origin;\n'
              '\n'
              '  const _QuickAddTimeEntryDialog({required this.origin});\n'
              '\n'
              '  @override\n'
              '  State<_QuickAddTimeEntryDialog> createState() =>\n'
              '      _QuickAddTimeEntryDialogState();\n'
              '}\n'
              '\n'
              'class _QuickAddTimeEntryDialogState extends State<_QuickAddTimeEntryDialog> {\n'
              '  late final TextEditingController _titleController;\n'
              '  late final TextEditingController _noteController;\n'
              '  late final TextEditingController _durationController;\n'
              '  late TimeOfDay _startTime;\n'
              '  TimeEntryCategory _category = TimeEntryCategory.work;\n'
              '  bool _submitting = false;\n'
              '  bool _saved = false;\n'
              '  ModalRoute<dynamic>? _owningRoute;\n'
              '  bool _originDismissalScheduled = false;\n'
              '\n'
              '  @override\n'
              '  void didChangeDependencies() {\n'
              '    super.didChangeDependencies();\n'
              '    _owningRoute ??= ModalRoute.of(context);\n'
              '  }\n'
              '\n'
              '  void _dismissOwningDialog() {\n'
              '    final route = _owningRoute ?? ModalRoute.of(context);\n'
              '    if (route != null && route.isActive) {\n'
              '      if (route.isCurrent) {\n'
              '        route.navigator?.pop();\n'
              '      } else {\n'
              '        route.navigator?.removeRoute(route);\n'
              '      }\n'
              '    }\n'
              '  }\n'
              '\n'
              '  void _showFeedbackError(BuildContext context) {\n'
              '    if (!context.mounted) return;\n'
              '    final messenger = ScaffoldMessenger.maybeOf(context);\n'
              '    if (messenger == null || !messenger.mounted) return;\n'
              '    messenger.showSnackBar(\n'
              '      const SnackBar(content: _CalendarFeedbackErrorText()),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  void initState() {\n'
              '    super.initState();\n'
              '    _titleController = TextEditingController();\n'
              '    _noteController = TextEditingController();\n'
              '    _durationController = TextEditingController(text: \'30\');\n'
              '    final now = DateTime.now();\n'
              '    _startTime = TimeOfDay.fromDateTime(\n'
              '      _isSameDay(widget.origin.selectedDay, now)\n'
              '          ? now\n'
              '          : DateTime(\n'
              '              widget.origin.selectedDay.year,\n'
              '              widget.origin.selectedDay.month,\n'
              '              widget.origin.selectedDay.day,\n'
              '              9,\n'
              '            ),\n'
              '    );\n'
              '    I18n.localeListenable.addListener(_onLocaleChanged);\n'
              '    AccountLocalDataCleaner.accountDataGenerationListenable.addListener(\n'
              '      _onOriginChanged,\n'
              '    );\n'
              '    widget.origin.callerAvailabilityListenable?.addListener(_onOriginChanged);\n'
              '  }\n'
              '\n'
              '  void _onOriginChanged() {\n'
              '    if (!mounted || widget.origin.isValid || _originDismissalScheduled) return;\n'
              '    _originDismissalScheduled = true;\n'
              '    WidgetsBinding.instance.addPostFrameCallback((_) {\n'
              '      _originDismissalScheduled = false;\n'
              '      if (!mounted || widget.origin.isValid) return;\n'
              '      _dismissOwningDialog();\n'
              '    });\n'
              '    WidgetsBinding.instance.scheduleFrame();\n'
              '  }\n'
              '\n'
              '  void _onLocaleChanged() {\n'
              '    if (mounted) setState(() {});\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  void dispose() {\n'
              '    I18n.localeListenable.removeListener(_onLocaleChanged);\n'
              '    AccountLocalDataCleaner.accountDataGenerationListenable.removeListener(\n'
              '      _onOriginChanged,\n'
              '    );\n'
              '    widget.origin.callerAvailabilityListenable?.removeListener(\n'
              '      _onOriginChanged,\n'
              '    );\n'
              '    _titleController.dispose();\n'
              '    _noteController.dispose();\n'
              '    _durationController.dispose();\n'
              '    super.dispose();\n'
              '  }\n'
              '\n'
              '  static bool _isSameDay(DateTime a, DateTime b) =>\n'
              '      a.year == b.year && a.month == b.month && a.day == b.day;\n'
              '\n'
              '  Future<void> _submit() async {\n'
              '    if (_submitting || _saved) return;\n'
              '    if (!mounted || !widget.origin.isValid) {\n'
              '      _dismissOwningDialog();\n'
              '      return;\n'
              '    }\n'
              '    final title = _titleController.text.trim();\n'
              '    final minutes = int.tryParse(_durationController.text.trim()) ?? 0;\n'
              '    if (title.isEmpty || minutes <= 0) return;\n'
              '    setState(() => _submitting = true);\n'
              '    try {\n'
              '      final start = DateTime(\n'
              '        widget.origin.selectedDay.year,\n'
              '        widget.origin.selectedDay.month,\n'
              '        widget.origin.selectedDay.day,\n'
              '        _startTime.hour,\n'
              '        _startTime.minute,\n'
              '      );\n'
              '      final end = start.add(Duration(minutes: minutes));\n'
              '      await context.read<TimeAuditProvider>().add(\n'
              '        TimeEntry(\n'
              '          title: title,\n'
              '          startAt: start,\n'
              '          endAt: end,\n'
              '          category: _category,\n'
              '          source: TimeEntrySource.manual,\n'
              '          note: _noteController.text.trim(),\n'
              '        ),\n'
              '      );\n'
              '      if (!mounted) return;\n'
              '      if (!widget.origin.isValid) {\n'
              '        _saved = true;\n'
              '        _dismissOwningDialog();\n'
              '        return;\n'
              '      }\n'
              '      _saved = true;\n'
              '      _dismissOwningDialog();\n'
              '    } catch (e) {\n'
              '      if (!mounted) return;\n'
              '      if (!widget.origin.isValid) {\n'
              '        _dismissOwningDialog();\n'
              '        return;\n'
              '      }\n'
              '      setState(() => _submitting = false);\n'
              '      _showFeedbackError(context);\n'
              '    }\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    return AppDialog(\n'
              '      title: Text(\n'
              '        CalendarUiCopy.quickAddTimeEntryDialogTitle(widget.origin.selectedDay),\n'
              '      ),\n'
              '      content: AppSecondaryControlTheme(\n'
              '        child: SingleChildScrollView(\n'
              '          child: Column(\n'
              '            mainAxisSize: MainAxisSize.min,\n'
              '            children: [\n'
              '              TextField(\n'
              '                controller: _titleController,\n'
              '                enabled: !_submitting && !_saved,\n'
              '                decoration: InputDecoration(\n'
              '                  labelText: CalendarUiCopy.timeEntryTitleLabel,\n'
              '                  prefixIcon: const Icon(Icons.title, size: 20),\n'
              '                ),\n'
              '                autofocus: true,\n'
              '              ),\n'
              '              const SizedBox(height: 12),\n'
              '              AppDropdownField<TimeEntryCategory>(\n'
              '                initialValue: _category,\n'
              '                labelText: CalendarUiCopy.timeEntryCategoryLabel,\n'
              '                prefixIcon: const Icon(Icons.label_outline, size: 20),\n'
              '                enabled: !_submitting && !_saved,\n'
              '                isInteractionAllowed: () {\n'
              '                  if (!mounted) return false;\n'
              '                  if (!widget.origin.isValid) {\n'
              '                    _dismissOwningDialog();\n'
              '                    return false;\n'
              '                  }\n'
              '                  return !_submitting && !_saved;\n'
              '                },\n'
              '                items: [\n'
              '                  for (final c in TimeEntryCategory.values)\n'
              '                    DropdownMenuItem(\n'
              '                      value: c,\n'
              '                      child: _LocaleAwareText(() => c.label),\n'
              '                    ),\n'
              '                ],\n'
              '                onChanged: (v) {\n'
              '                  if (!mounted ||\n'
              '                      !widget.origin.isValid ||\n'
              '                      _submitting ||\n'
              '                      _saved) {\n'
              '                    return;\n'
              '                  }\n'
              '                  if (v != null) setState(() => _category = v);\n'
              '                },\n'
              '              ),\n'
              '              const SizedBox(height: 12),\n'
              '              ListTile(\n'
              '                contentPadding: EdgeInsets.zero,\n'
              '                leading: const Icon(Icons.schedule),\n'
              '                title: Text(CalendarUiCopy.timeEntryStartTimeLabel),\n'
              '                subtitle: Text(AppTimePicker.format(_startTime)),\n'
              '                enabled: !_submitting && !_saved,\n'
              '                onTap: (_submitting || _saved)\n'
              '                    ? null\n'
              '                    : () async {\n'
              '                        if (!mounted || !widget.origin.isValid) {\n'
              '                          _dismissOwningDialog();\n'
              '                          return;\n'
              '                        }\n'
              '                        final picked = await AppTimePicker.show(\n'
              '                          context,\n'
              '                          initialTime: _startTime,\n'
              '                          titleKey: \'calendar.content.time_picker_start_time\',\n'
              '                          minuteStep: 5,\n'
              '                        );\n'
              '                        if (!mounted || !widget.origin.isValid) return;\n'
              '                        if (picked != null) {\n'
              '                          setState(() => _startTime = picked);\n'
              '                        }\n'
              '                      },\n'
              '              ),\n'
              '              const SizedBox(height: 8),\n'
              '              TextField(\n'
              '                controller: _durationController,\n'
              '                enabled: !_submitting && !_saved,\n'
              '                decoration: InputDecoration(\n'
              '                  labelText: CalendarUiCopy.timeEntryDurationLabel,\n'
              '                  prefixIcon: const Icon(Icons.timelapse, size: 20),\n'
              '                ),\n'
              '                keyboardType: TextInputType.number,\n'
              '              ),\n'
              '              const SizedBox(height: 12),\n'
              '              TextField(\n'
              '                controller: _noteController,\n'
              '                enabled: !_submitting && !_saved,\n'
              '                decoration: InputDecoration(\n'
              '                  labelText: CalendarUiCopy.timeEntryNoteLabel,\n'
              '                  prefixIcon: const Icon(Icons.notes_outlined, size: 20),\n'
              '                ),\n'
              '                maxLines: 2,\n'
              '              ),\n'
              '            ],\n'
              '          ),\n'
              '        ),\n'
              '      ),\n'
              '      actions: [\n'
              '        TextButton(\n'
              '          onPressed: (_submitting || _saved) ? null : _dismissOwningDialog,\n'
              '          child: Text(I18n.tr(\'action.cancel\')),\n'
              '        ),\n'
              '        FilledButton(\n'
              '          onPressed: (_submitting || _saved) ? null : _submit,\n'
              '          child: _submitting\n'
              '              ? const SizedBox(\n'
              '                  width: 18,\n'
              '                  height: 18,\n'
              '                  child: CircularProgressIndicator(strokeWidth: 2),\n'
              '                )\n'
              '              : Text(CalendarUiCopy.timeEntrySubmitButton),\n'
              '        ),\n'
              '      ],\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
