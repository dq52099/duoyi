              '        courseSettings: courseProvider.settings,\n'
              '        diaries: diaryProvider.entries,\n'
              '        countdowns: countdownProvider.items,\n'
              '        goals: goalProvider.goals,\n'
              '        timeEntries: timeAuditProvider.entries,\n'
              '      );\n'
              '    });\n'
              '  }\n'
              '\n'
              '  Object _calendarInputSignature({\n'
              '    required TodoProvider todoProvider,\n'
              '    required HabitProvider habitProvider,\n'
              '    required PomodoroProvider pomodoroProvider,\n'
              '    required CalendarProvider calendarProvider,\n'
              '    required AnniversaryProvider anniversaryProvider,\n'
              '    required CountdownProvider countdownProvider,\n'
              '    required CourseProvider courseProvider,\n'
              '    required DiaryProvider diaryProvider,\n'
              '    required GoalProvider goalProvider,\n'
              '    required TimeAuditProvider timeAuditProvider,\n'
              '    required ColorScheme colorScheme,\n'
              '  }) {\n'
              '    final now = DateTime.now();\n'
              '    final todayKey = DateTime(\n'
              '      now.year,\n'
              '      now.month,\n'
              '      now.day,\n'
              '    ).millisecondsSinceEpoch;\n'
              '    return Object.hashAll([\n'
              '      todayKey,\n'
              '      colorScheme.primary,\n'
              '      calendarProvider.sourceRevision,\n'
              '      _todoSignature(todoProvider.todos),\n'
              '      _habitSignature(habitProvider.habits),\n'
              '      _pomodoroSignature(pomodoroProvider.sessions),\n'
              '      _anniversarySignature(anniversaryProvider.items),\n'
              '      _countdownSignature(countdownProvider.items),\n'
              '      _courseSignature(courseProvider.courses, courseProvider.settings),\n'
              '      _diarySignature(diaryProvider.entries),\n'
              '      _goalSignature(goalProvider.goals),\n'
              '      _timeEntrySignature(timeAuditProvider.entries),\n'
              '    ]);\n'
              '  }\n'
              '\n'
              '  Object _todoSignature(List<TodoItem> todos) => Object.hashAll([\n'
              '    todos.length,\n'
              '    for (final item in todos)\n'
              '      Object.hash(\n'
              '        item.id,\n'
              '        item.title,\n'
              '        item.date.millisecondsSinceEpoch,\n'
              '        item.dueDate?.millisecondsSinceEpoch,\n'
              '        item.isCompleted,\n'
              '        item.listGroupId,\n'
              '        item.listGroupName,\n'
              '        item.workspaceId,\n'
              '        item.updatedAt.millisecondsSinceEpoch,\n'
              '      ),\n'
              '  ]);\n'
              '\n'
              '  Object _habitSignature(List<Habit> habits) => Object.hashAll([\n'
              '    habits.length,\n'
              '    for (final item in habits)\n'
              '      Object.hash(\n'
              '        item.id,\n'
              '        item.name,\n'
              '        item.colorValue,\n'
              '        item.kind.index,\n'
              '        item.targetCount,\n'
              '        item.unit,\n'
              '        item.updatedAt.millisecondsSinceEpoch,\n'
              '      ),\n'
              '  ]);\n'
              '\n'
              '  Object _pomodoroSignature(List<PomodoroSession> sessions) => Object.hashAll([\n'
              '    sessions.length,\n'
              '    for (final item in sessions)\n'
              '      Object.hash(\n'
              '        item.id,\n'
              '        item.startTime.millisecondsSinceEpoch,\n'
              '        item.endTime.millisecondsSinceEpoch,\n'
              '        item.durationSeconds,\n'
              '        item.type.index,\n'
              '        item.taskName,\n'
              '        item.whiteNoiseSound,\n'
              '        item.updatedAt.millisecondsSinceEpoch,\n'
              '      ),\n'
              '  ]);\n'
              '\n'
              '  Object _anniversarySignature(List<Anniversary> items) => Object.hashAll([\n'
              '    items.length,\n'
              '    for (final item in items)\n'
              '      Object.hash(\n'
              '        item.id,\n'
              '        item.title,\n'
              '        item.originDate.millisecondsSinceEpoch,\n'
              '        item.type.index,\n'
              '        item.calendarType.index,\n'
              '        item.colorValue,\n'
              '        item.ignoreYear,\n'
              '        item.updatedAt.millisecondsSinceEpoch,\n'
              '      ),\n'
              '  ]);\n'
              '\n'
              '  Object _countdownSignature(List<CountdownItem> items) => Object.hashAll([\n'
              '    items.length,\n'
              '    for (final item in items)\n'
              '      Object.hash(\n'
              '        item.id,\n'
              '        item.title,\n'
              '        item.targetDate.millisecondsSinceEpoch,\n'
              '        item.isPinned,\n'
              '        item.category,\n'
              '        item.updatedAt.millisecondsSinceEpoch,\n'
              '      ),\n'
              '  ]);\n'
              '\n'
              '  Object _courseSignature(\n'
              '    List<CourseItem> courses,\n'
              '    ScheduleSettings settings,\n'
              '  ) => Object.hashAll([\n'
              '    settings.termStart.millisecondsSinceEpoch,\n'
              '    settings.totalWeeks,\n'
              '    settings.sessionsPerDay,\n'
              '    settings.sessionMinutes,\n'
              '    settings.firstSessionHour,\n'
              '    settings.firstSessionMinute,\n'
              '    settings.breakMinutes,\n'
              '    courses.length,\n'
              '    for (final item in courses)\n'
              '      Object.hash(\n'
              '        item.id,\n'
              '        item.name,\n'
              '        item.weekday,\n'
              '        item.startSection,\n'
              '        item.sectionCount,\n'
              '        Object.hashAll(item.weeks),\n'
              '        item.updatedAt.millisecondsSinceEpoch,\n'
              '      ),\n'
              '  ]);\n'
              '\n'
              '  Object _diarySignature(List<DiaryEntry> entries) => Object.hashAll([\n'
              '    entries.length,\n'
              '    for (final item in entries)\n'
              '      Object.hash(item.id, item.dateKey, item.updatedAt.millisecondsSinceEpoch),\n'
              '  ]);\n'
              '\n'
              '  Object _goalSignature(List<GoalItem> goals) => Object.hashAll([\n'
              '    goals.length,\n'
              '    for (final item in goals)\n'
              '      Object.hash(\n'
              '        item.id,\n'
              '        item.title,\n'
              '        item.targetDate?.millisecondsSinceEpoch,\n'
              '        item.status.index,\n'
              '        item.colorValue,\n'
              '        item.autoProgress,\n'
              '        item.computedProgress,\n'
              '        item.workspaceId,\n'
              '        item.updatedAt.millisecondsSinceEpoch,\n'
              '      ),\n'
              '  ]);\n'
              '\n'
              '  Object _timeEntrySignature(List<TimeEntry> entries) => Object.hashAll([\n'
              '    entries.length,\n'
              '    for (final item in entries)\n'
              '      Object.hash(\n'
              '        item.id,\n'
              '        item.title,\n'
              '        item.startAt.millisecondsSinceEpoch,\n'
              '        item.endAt.millisecondsSinceEpoch,\n'
              '        item.category.index,\n'
              '        item.source.index,\n'
              '        item.sourceId,\n'
              '        item.updatedAt.millisecondsSinceEpoch,\n'
              '      ),\n'
              '  ]);\n'
              '\n'
              '  void _showQuickAddTodo({_CalendarOriginScope? origin}) {\n'
              '    final effectiveOrigin = origin ?? _createOriginScope();\n'
              '    if (!effectiveOrigin.isValid) return;\n'
              '    showDialog<void>(\n'
              '      context: context,\n'
              '      builder: (_) => _QuickAddTodoDialog(origin: effectiveOrigin),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  void _previousMonth() {\n'
              '    setState(() {\n'
              '      _focusedMonth = DateTime(_focusedMonth.year, _focusedMonth.month - 1);\n'
              '      _selectedDay = _clampSelectedDayToFocusedMonth();\n'
              '    });\n'
              '  }\n'
              '\n'
              '  void _nextMonth() {\n'
              '    setState(() {\n'
              '      _focusedMonth = DateTime(_focusedMonth.year, _focusedMonth.month + 1);\n'
              '      _selectedDay = _clampSelectedDayToFocusedMonth();\n'
              '    });\n'
              '  }\n'
              '\n'
              '  void _previousWeek() {\n'
              '    setState(() {\n'
              '      _selectedDay = _selectedDay.subtract(const Duration(days: 7));\n'
              '      _focusedMonth = DateTime(_selectedDay.year, _selectedDay.month);\n'
              '    });\n'
              '  }\n'
              '\n'
              '  void _nextWeek() {\n'
              '    setState(() {\n'
              '      _selectedDay = _selectedDay.add(const Duration(days: 7));\n'
              '      _focusedMonth = DateTime(_selectedDay.year, _selectedDay.month);\n'
              '    });\n'
              '  }\n'
              '\n'
              '  void _previousDay() {\n'
              '    setState(() {\n'
              '      _selectedDay = _selectedDay.subtract(const Duration(days: 1));\n'
              '      _focusedMonth = DateTime(_selectedDay.year, _selectedDay.month);\n'
              '    });\n'
              '  }\n'
              '\n'
              '  void _nextDay() {\n'
              '    setState(() {\n'
              '      _selectedDay = _selectedDay.add(const Duration(days: 1));\n'
              '      _focusedMonth = DateTime(_selectedDay.year, _selectedDay.month);\n'
              '    });\n'
              '  }\n'
              '\n'
              '  void _previousThreeDays() {\n'
              '    setState(() {\n'
              '      _selectedDay = _selectedDay.subtract(const Duration(days: 3));\n'
              '      _focusedMonth = DateTime(_selectedDay.year, _selectedDay.month);\n'
              '    });\n'
              '  }\n'
              '\n'
              '  void _nextThreeDays() {\n'
              '    setState(() {\n'
              '      _selectedDay = _selectedDay.add(const Duration(days: 3));\n'
              '      _focusedMonth = DateTime(_selectedDay.year, _selectedDay.month);\n'
              '    });\n'
              '  }\n'
              '\n'
              '  void _previousYear() {\n'
              '    setState(() {\n'
              '      _focusedMonth = DateTime(_focusedMonth.year - 1, _focusedMonth.month);\n'
              '      final targetYear = _selectedDay.year - 1;\n'
              '      final lastDay = DateTime(targetYear, _selectedDay.month + 1, 0).day;\n'
              '      final day = _selectedDay.day.clamp(1, lastDay);\n'
              '      _selectedDay = DateTime(targetYear, _selectedDay.month, day);\n'
              '    });\n'
              '  }\n'
              '\n'
              '  void _nextYear() {\n'
              '    setState(() {\n'
              '      _focusedMonth = DateTime(_focusedMonth.year + 1, _focusedMonth.month);\n'
              '      final targetYear = _selectedDay.year + 1;\n'
              '      final lastDay = DateTime(targetYear, _selectedDay.month + 1, 0).day;\n'
              '      final day = _selectedDay.day.clamp(1, lastDay);\n'
              '      _selectedDay = DateTime(targetYear, _selectedDay.month, day);\n'
              '    });\n'
              '  }\n'
              '\n'
              '  int _monthGridRows(DateTime focusedMonth) {\n'
              '    final firstDay = DateTime(focusedMonth.year, focusedMonth.month, 1);\n'
              '    final lastDay = DateTime(focusedMonth.year, focusedMonth.month + 1, 0);\n'
              '    final startOffset = (firstDay.weekday - 1) % 7;\n'
              '    return ((startOffset + lastDay.day) / 7).ceil();\n'
              '  }\n'
              '\n'
              '  double _monthGridHeightFor(double availableHeight, int rows) {\n'
              '    final minGridHeight = rows >= 6 ? 288.0 : (rows == 5 ? 260.0 : 236.0);\n'
              '    final preferredGridHeight = rows >= 6 ? 318.0 : (rows == 5 ? 292.0 : 268.0);\n'
              '    if (!availableHeight.isFinite) return preferredGridHeight;\n'
              '    final viewportTarget = availableHeight * 0.46;\n'
              '    return viewportTarget.clamp(minGridHeight, preferredGridHeight).toDouble();\n'
              '  }\n'
              '\n'
              '  Widget _calendarFilterChip({\n'
              '    Widget? avatar,\n'
              '    required Widget label,\n'
              '    required bool selected,\n'
              '    required ValueChanged<bool> onSelected,\n'
              '  }) {\n'
              '    final cs = Theme.of(context).colorScheme;\n'
              '    return Padding(\n'
              '      padding: const EdgeInsets.only(right: 6),\n'
              '      child: FilterChip(\n'
              '        avatar: avatar,\n'
              '        label: label,\n'
              '        selected: selected,\n'
              '        onSelected: onSelected,\n'
              '        showCheckmark: false,\n'
              '        labelStyle: appSecondaryControlLabelStyle(context),\n'
              '        visualDensity: VisualDensity.compact,\n'
              '        materialTapTargetSize: MaterialTapTargetSize.padded,\n'
              '        side: BorderSide(\n'
              '          color: selected\n'
              '              ? cs.primary.withValues(alpha: 0.24)\n'
              '              : cs.outlineVariant.withValues(alpha: 0.16),\n'
              '          width: 0.45,\n'
              '        ),\n'
              '        padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 1),\n'
              '        labelPadding: const EdgeInsets.symmetric(horizontal: 2),\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  Widget _calendarActionChip({\n'
              '    required Widget avatar,\n'
              '    required Widget label,\n'
              '    required VoidCallback onPressed,\n'
              '  }) {\n'
              '    final cs = Theme.of(context).colorScheme;\n'
              '    return Padding(\n'
              '      padding: const EdgeInsets.only(right: 6),\n'
              '      child: ActionChip(\n'
              '        avatar: avatar,\n'
              '        label: label,\n'
              '        labelStyle: appSecondaryControlLabelStyle(context),\n'
              '        visualDensity: VisualDensity.compact,\n'
              '        materialTapTargetSize: MaterialTapTargetSize.padded,\n'
              '        side: BorderSide(\n'
              '          color: cs.outlineVariant.withValues(alpha: 0.16),\n'
              '          width: 0.45,\n'
              '        ),\n'
              '        padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 1),\n'
              '        labelPadding: const EdgeInsets.symmetric(horizontal: 2),\n'
              '        onPressed: onPressed,\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  bool _monthGridShowsLunar(double gridHeight, int rows) {\n'
              '    if (rows <= 0) return false;\n'
              '    const monthGridChromeHeight = 36.0;\n'
              '    final rowHeight = (gridHeight - monthGridChromeHeight) / rows;\n'
              '    return rowHeight >= 50;\n'
              '  }\n'
              '\n'
              '  Widget _calendarFilterStrip({\n'
              '    required List<_CalendarWorkspaceOption> workspaceOptions,\n'
              '    required String? effectiveWorkspaceId,\n'
              '    required List<_CalendarProjectOption> projectOptions,\n'
              '    required String? effectiveProjectKey,\n'
              '    required List<TodoItem> workspaceTodos,\n'
              '  }) {\n'
              '    return SizedBox(\n'
              '      key: const ValueKey(\'calendar_unified_filter_strip\'),\n'
              '      height: 48,\n'
              '      child: DefaultTextStyle.merge(\n'
              '        style: appSecondaryControlLabelStyle(context),\n'
              '        child: ListView(\n'
              '          scrollDirection: Axis.horizontal,\n'
              '          padding: const EdgeInsets.symmetric(horizontal: 12),\n'
              '          children: [\n'
              '            _calendarFilterChip(\n'
              '              label: Text(CalendarUiCopy.filterAll),\n'
              '              selected: _activeTypes == null,\n'
              '              onSelected: (_) => setState(() => _activeTypes = null),\n'
              '            ),\n'
              '            if (projectOptions.isNotEmpty) ...[\n'
              '              const SizedBox(width: 6),\n'
              '              _calendarFilterChip(\n'
              '                avatar: const Icon(Icons.folder_outlined, size: 16),\n'
              '                label: Text(CalendarUiCopy.filterAllProjects),\n'
              '                selected: effectiveProjectKey == null,\n'
              '                onSelected: (_) => setState(() => _activeProjectKey = null),\n'
              '              ),\n'
              '              for (final option in projectOptions)\n'
              '                _calendarFilterChip(\n'
              '                  label: Text(\'${option.displayName} ${option.count}\'),\n'
              '                  selected: effectiveProjectKey == option.key,\n'
              '                  onSelected: (_) {\n'
              '                    setState(() {\n'
              '                      _activeProjectKey = option.key;\n'
              '                      if (_activeTypes != null &&\n'
              '                          !_activeTypes!.contains(CalendarEventType.todo)) {\n'
              '                        _activeTypes = {CalendarEventType.todo};\n'
              '                      }\n'
              '                    });\n'
              '                  },\n'
              '                ),\n'
              '              if (effectiveProjectKey != null)\n'
              '                _calendarActionChip(\n'
              '                  avatar: const Icon(Icons.info_outline, size: 16),\n'
              '                  label: Text(CalendarUiCopy.projectDetailAction),\n'
              '                  onPressed: () {\n'
              '                    final option = projectOptions.firstWhere(\n'
              '                      (item) => item.key == effectiveProjectKey,\n'
              '                    );\n'
              '                    _showProjectDetail(\n'
              '                      context,\n'
              '                      option,\n'
              '                      _projectTodos(workspaceTodos, option.key),\n'
              '                    );\n'
              '                  },\n'
              '                ),\n'
              '            ],\n'
              '            if (workspaceOptions.isNotEmpty) ...[\n'
              '              const SizedBox(width: 6),\n'
              '              _calendarFilterChip(\n'
              '                avatar: const Icon(Icons.groups_2_outlined, size: 16),\n'
              '                label: Text(CalendarUiCopy.filterAllWorkspaces),\n'
              '                selected: effectiveWorkspaceId == null,\n'
              '                onSelected: (_) => setState(() => _activeWorkspaceId = null),\n'
              '              ),\n'
              '              for (final option in workspaceOptions)\n'
              '                _calendarFilterChip(\n'
              '                  avatar: Icon(\n'
              '                    option.isPrivate\n'
              '                        ? Icons.lock_outline\n'
              '                        : Icons.groups_2_outlined,\n'
              '                    size: 16,\n'
              '                  ),\n'
              '                  label: Text(\'${option.displayName} ${option.count}\'),\n'
              '                  selected: effectiveWorkspaceId == option.id,\n'
              '                  onSelected: (_) {\n'
              '                    setState(() {\n'
              '                      _activeWorkspaceId = option.id;\n'
              '                    });\n'
              '                  },\n'
              '                ),\n'
              '            ],\n'
              '            for (final type in CalendarEventType.values)\n'
              '              _calendarFilterChip(\n'
              '                label: Text(type.label),\n'
              '                selected: _activeTypes?.contains(type) ?? false,\n'
              '                onSelected: (selected) {\n'
              '                  setState(() {\n'
              '                    if (_activeTypes == null) {\n'
              '                      _activeTypes = {type};\n'
              '                    } else if (selected) {\n'
              '                      _activeTypes = {..._activeTypes!, type};\n'
              '                    } else {\n'
              '                      final next = {..._activeTypes!}..remove(type);\n'
              '                      _activeTypes = next.isEmpty ? null : next;\n'
              '                    }\n'
              '                  });\n'
              '                },\n'
              '              ),\n'
              '          ],\n'
              '        ),\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  DateTime _clampSelectedDayToFocusedMonth() {\n'
              '    final lastDay = DateTime(\n'
              '      _focusedMonth.year,\n'
              '      _focusedMonth.month + 1,\n'
              '      0,\n'
              '    ).day;\n'
              '    final day = _selectedDay.day.clamp(1, lastDay);\n'
              '    return DateTime(_focusedMonth.year, _focusedMonth.month, day);\n'
              '  }\n'
              '\n'
              '  Future<void> _pickDate() async {\n'
              '    final origin = _createOriginScope();\n'
              '    final picked = await AppDatePicker.pickSolar(\n'
              '      context,\n'
              '      initialDate: _selectedDay,\n'
              '      firstDate: DateTime(1900),\n'
              '      lastDate: DateTime(2099, 12, 31),\n'
              '      titleKey: \'calendar.content.date_picker_title\',\n'
              '      subtitleKey: \'calendar.content.date_picker_subtitle\',\n'
              '    );\n'
              '    if (!origin.isValid) return;\n'
              '    if (picked == null) return;\n'
              '    setState(() {\n'
              '      _selectedDay = picked;\n'
              '      _focusedMonth = DateTime(picked.year, picked.month);\n'
              '    });\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final todoProvider = context.watch<TodoProvider>();\n'
              '    final habitProvider = context.watch<HabitProvider>();\n'
              '    context.select<PomodoroProvider, int>(\n'
              '      (provider) => provider.persistedRevision,\n'
              '    );\n'
              '    final pomodoroProvider = context.read<PomodoroProvider>();\n'
              '    final calendarProvider = context.watch<CalendarProvider>();\n'
              '    final anniversaryProvider = context.watch<AnniversaryProvider>();\n'
              '    final countdownProvider = context.watch<CountdownProvider>();\n'
              '    final courseProvider = context.watch<CourseProvider>();\n'
              '    final diaryProvider = context.watch<DiaryProvider>();\n'
              '    final goalProvider = context.watch<GoalProvider>();\n'
              '    final shareProvider = context.watch<ShareProvider>();\n'
              '    final timeAuditProvider = context.watch<TimeAuditProvider>();\n'
              '    final s = context.watch<ThemeProvider>().brand.strings;\n'
              '    final cs = Theme.of(context).colorScheme;\n'
              '\n'
              '    _scheduleCalendarRebuild(\n'
              '      todoProvider: todoProvider,\n'
              '      habitProvider: habitProvider,\n'
              '      pomodoroProvider: pomodoroProvider,\n'
              '      calendarProvider: calendarProvider,\n'
              '      anniversaryProvider: anniversaryProvider,\n'
              '      countdownProvider: countdownProvider,\n'
              '      courseProvider: courseProvider,\n'
              '      diaryProvider: diaryProvider,\n'
              '      goalProvider: goalProvider,\n'
              '      timeAuditProvider: timeAuditProvider,\n'
              '      colorScheme: cs,\n'
              '    );\n'
              '\n'
              '    final workspaceOptions = _workspaceOptions(\n'
              '      todoProvider.todos,\n'
              '      goalProvider.goals,\n'
              '      calendarProvider.localEvents,\n'
              '      shareProvider.workspaces,\n'
              '    );\n'
              '    final effectiveWorkspaceId =\n'
              '        workspaceOptions.any((option) => option.id == _activeWorkspaceId)\n'
              '        ? _activeWorkspaceId\n'
              '        : null;\n'
              '    final workspaceTodos = _workspaceTodos(\n'
              '      todoProvider.todos,\n'
              '      effectiveWorkspaceId,\n'
              '    );\n'
              '    final projectOptions = _projectOptions(workspaceTodos);\n'
              '    final effectiveProjectKey =\n'
              '        projectOptions.any((option) => option.key == _activeProjectKey)\n'
              '        ? _activeProjectKey\n'
              '        : null;\n'
              '    final hasActiveCalendarFilters =\n'
              '        _activeTypes != null ||\n'
              '        effectiveProjectKey != null ||\n'
              '        effectiveWorkspaceId != null;\n'
              '    final dateTypes = calendarProvider.filteredDateEventTypes(\n'
              '      _activeTypes,\n'
              '      projectKey: effectiveProjectKey,\n'
              '      workspaceId: effectiveWorkspaceId,\n'
              '    );\n'
              '    final dateCounts = calendarProvider.filteredDateEventCounts(\n'
              '      _activeTypes,\n'
              '      projectKey: effectiveProjectKey,\n'
              '      workspaceId: effectiveWorkspaceId,\n'
              '    );\n'
              '    final monthLabel = CalendarUiCopy.monthHeader(_focusedMonth);\n'
              '    final weekStart = _selectedDay.subtract(\n'
              '      Duration(days: _selectedDay.weekday - 1),\n'
              '    );\n'
              '    final weekEnd = weekStart.add(const Duration(days: 6));\n'
              '    final weekLabel =\n'
              '        \'${I18nDateFormat.monthDay(weekStart)} - ${I18nDateFormat.monthDay(weekEnd)}\';\n'
              '    final threeDayEnd = _selectedDay.add(const Duration(days: 2));\n'
              '    final threeDayLabel =\n'
              '        \'${I18nDateFormat.monthDay(_selectedDay)} - ${I18nDateFormat.monthDay(threeDayEnd)}\';\n'
              '    final yearLabel = CalendarUiCopy.yearHeader(_focusedMonth.year);\n'
              '    final routeBackground = Theme.of(context).brightness == Brightness.dark\n'
              '        ? Theme.of(context).colorScheme.surface\n'
              '        : Theme.of(context).colorScheme.surfaceContainerLowest;\n'
              '\n'
              '    return BrandScaffold(\n'
              '      paintBackground: !widget.useShellBackground,\n'
              '      appBar: AppBar(\n'
              '        title: Text(MainUiCopy.calendarTitle),\n'
              '        titleTextStyle: widget.useShellBackground\n'
              '            ? null\n'
              '            : appSecondaryRouteTitleTextStyle(context),\n'
              '        backgroundColor: widget.useShellBackground\n'
