<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_picker_preview_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_preview_standard_title"
        android:textColor="#FF0066D6"
        android:textStyle="normal"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_preview_standard_sample_one"
        android:textColor="#FF1F2933"
        android:textStyle="normal"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_preview_standard_sample_two"
        android:textColor="#FF1F2933"
        android:textStyle="normal"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center"
        android:ellipsize="end"
        android:maxLines="1"
        android:background="@drawable/widget_picker_preview_nav_background"
        android:text="@string/widget_preview_navigation_labels"
        android:textColor="#FF667085"
        android:textStyle="normal"
        android:textSize="10sp" />
</LinearLayout>
